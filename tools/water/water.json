{
  "_doc": "Vattenfliken i Väderkvarnen (docs/effektlabb.md, E3): spakarna, färdiga vattentyper och de fyra scenerna (öppet vatten, strand, bäck, sjö). Ytan är shared/effects/water.js (Gerstnervågor, brytning genom djupet, Beer–Lambert, spegling, skum, kaustik, krusningar). Himlen, ljuset, dimman och nederbörden är Väder-flikens atmosfär (shared/effects/weather.js): kortet Weather väljer ett väderläge ur tools/weather/weather.json eller assets/weather/. Spakar med \"recipe\": false (scenen och himlen) sparas inte i vattentypen. Texten som visas är på engelska. Sparade vattentyper hamnar i assets/water/<namn>.water.json.",
  "groups": [
    {
      "id": "scene",
      "label": "Scene"
    },
    {
      "id": "sky",
      "label": "Weather"
    },
    {
      "id": "color",
      "label": "Colour & depth"
    },
    {
      "id": "waves",
      "label": "Waves"
    },
    {
      "id": "light",
      "label": "Reflections & light"
    },
    {
      "id": "foam",
      "label": "Foam"
    },
    {
      "id": "shore",
      "label": "Shore"
    },
    {
      "id": "flow",
      "label": "Flow"
    },
    {
      "id": "caustics",
      "label": "Caustics"
    }
  ],
  "params": [
    {
      "key": "scene",
      "group": "scene",
      "label": "Scene",
      "type": "choice",
      "recipe": false,
      "default": "lake",
      "options": [
        {
          "id": "plane",
          "label": "Open water",
          "help": "Only water to the horizon: waves, colour and the sky"
        },
        {
          "id": "beach",
          "label": "Beach",
          "help": "A sandy beach where the waves wash in and leave wet sand behind"
        },
        {
          "id": "stream",
          "label": "Stream",
          "help": "A stream through a meadow with stones, reeds, cattails and water lilies"
        },
        {
          "id": "lake",
          "label": "Lake",
          "help": "A small lake with trees on the shore, for reflections"
        }
      ],
      "help": "Which place the water is tried in. Each place starts with a fitting water type"
    },
    {
      "key": "weather",
      "group": "sky",
      "label": "Weather",
      "type": "choice",
      "recipe": false,
      "default": "noon",
      "options": [],
      "help": "The weather from the Weather tab (ready-made and saved): sun or moon, clouds, fog, rain, snow and thunder. The time and the sun direction below adjust it for the scene"
    },
    {
      "key": "hour",
      "group": "sky",
      "label": "Time of day",
      "recipe": false,
      "min": 0,
      "max": 24,
      "step": 0.05,
      "default": 9,
      "help": "The time of day (the weather's own time is replaced): sun by day, moon and stars by night"
    },
    {
      "key": "azimuth",
      "group": "sky",
      "label": "Sun direction",
      "recipe": false,
      "min": 0,
      "max": 359,
      "step": 1,
      "default": 20,
      "help": "The compass direction of the sun (0 = straight ahead of the camera, which gives a glittering path across the water)"
    },
    {
      "key": "exposure",
      "group": "sky",
      "label": "Exposure",
      "recipe": false,
      "min": 0.4,
      "max": 2,
      "step": 0.01,
      "default": 1.05,
      "help": "Overall brightness (on top of the weather's own)"
    },
    {
      "key": "shallow",
      "group": "color",
      "label": "Shallow",
      "type": "color",
      "default": "#3fa6a0",
      "help": "The water's own colour where it is shallow"
    },
    {
      "key": "deep",
      "group": "color",
      "label": "Deep",
      "type": "color",
      "default": "#0d3a5a",
      "help": "The water's own colour where it is deep"
    },
    {
      "key": "clarity",
      "group": "color",
      "label": "Clarity",
      "min": 0.2,
      "max": 20,
      "step": 0.1,
      "default": 4,
      "help": "How many metres down you can see. Red light is swallowed first, then green, so deep water turns blue-green (Beer–Lambert)"
    },
    {
      "key": "deepAt",
      "group": "color",
      "label": "Deep at",
      "min": 0.5,
      "max": 20,
      "step": 0.1,
      "default": 4,
      "help": "At what depth (metres) the water has the deep colour"
    },
    {
      "key": "waveHeight",
      "group": "waves",
      "label": "Height",
      "min": 0,
      "max": 2,
      "step": 0.01,
      "default": 0.12,
      "help": "The height of the largest waves in metres (four Gerstner waves of different lengths and directions)"
    },
    {
      "key": "waveLength",
      "group": "waves",
      "label": "Length",
      "min": 1,
      "max": 60,
      "step": 0.5,
      "default": 8,
      "help": "The length of the largest wave in metres. The others are shorter. Long waves travel faster, as in real water"
    },
    {
      "key": "choppiness",
      "group": "waves",
      "label": "Sharpness",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 0.35,
      "help": "Rounded swell at 0, sharp crests and flat troughs at 1"
    },
    {
      "key": "waveDir",
      "group": "waves",
      "label": "Direction",
      "min": 0,
      "max": 359,
      "step": 1,
      "default": 30,
      "help": "Which way the waves travel (0 = away from the camera, 180 = toward it)"
    },
    {
      "key": "waveSpeed",
      "group": "waves",
      "label": "Speed",
      "min": 0,
      "max": 2,
      "step": 0.01,
      "default": 1,
      "help": "Faster or slower than real waves of the same length"
    },
    {
      "key": "ripples",
      "group": "waves",
      "label": "Ripples",
      "min": 0,
      "max": 1.5,
      "step": 0.01,
      "default": 0.45,
      "help": "Small ripples from the wind, in two layers that cross each other"
    },
    {
      "key": "rippleScale",
      "group": "waves",
      "label": "Ripple size",
      "min": 0.2,
      "max": 6,
      "step": 0.05,
      "default": 1.6,
      "help": "The size of the ripples in metres"
    },
    {
      "key": "reflections",
      "group": "light",
      "label": "Reflections",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 1,
      "help": "How much of the sky and the shore the water mirrors (strongest at a glancing angle, Fresnel)"
    },
    {
      "key": "mirror",
      "group": "light",
      "label": "Mirror",
      "type": "bool",
      "default": true,
      "sub": "Trees and shore too",
      "help": "On: the scene is drawn once more, mirrored in the water (planar reflection at half resolution). Off: the water only mirrors the sky, which is cheaper"
    },
    {
      "key": "distortion",
      "group": "light",
      "label": "Distortion",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 0.3,
      "help": "How much the waves break up the mirror image"
    },
    {
      "key": "refraction",
      "group": "light",
      "label": "Refraction",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 0.35,
      "help": "How much the waves bend what you see under the surface"
    },
    {
      "key": "glitter",
      "group": "light",
      "label": "Sun glitter",
      "min": 0,
      "max": 4,
      "step": 0.05,
      "default": 1.4,
      "help": "The sun's sparkle on the waves"
    },
    {
      "key": "glitterSize",
      "group": "light",
      "label": "Glitter sharpness",
      "min": 20,
      "max": 2000,
      "step": 10,
      "default": 400,
      "help": "Low: a broad shine. High: small sharp sparkles"
    },
    {
      "key": "shoreFoam",
      "group": "foam",
      "label": "Shore foam",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 0.35,
      "help": "Foam where the water is shallow, at the shore and around stones"
    },
    {
      "key": "foamWidth",
      "group": "foam",
      "label": "Shore width",
      "min": 0.02,
      "max": 2,
      "step": 0.01,
      "default": 0.25,
      "help": "How deep the water can be and still foam (metres)"
    },
    {
      "key": "crestFoam",
      "group": "foam",
      "label": "Crest foam",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 0,
      "help": "White caps on sharp wave crests"
    },
    {
      "key": "foamScale",
      "group": "foam",
      "label": "Foam size",
      "min": 0.2,
      "max": 4,
      "step": 0.05,
      "default": 1,
      "help": "The size of the bubbles and patches in the foam"
    },
    {
      "key": "edge",
      "group": "shore",
      "label": "Soft edge",
      "min": 0.005,
      "max": 0.4,
      "step": 0.005,
      "default": 0.06,
      "help": "How softly the water fades out against the shore (metres of depth)"
    },
    {
      "key": "wetShore",
      "group": "shore",
      "label": "Wet shore",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 0.6,
      "help": "How dark and shiny the ground is just above the water"
    },
    {
      "key": "wetBand",
      "group": "shore",
      "label": "Wet band",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 0.12,
      "help": "How high above the water the ground is wet (metres)"
    },
    {
      "key": "surge",
      "group": "shore",
      "label": "Wash",
      "min": 0,
      "max": 0.6,
      "step": 0.01,
      "default": 0,
      "help": "How high the water washes up the shore with each wave (metres). The sand stays wet a while after it pulls back"
    },
    {
      "key": "surgePeriod",
      "group": "shore",
      "label": "Wash period",
      "min": 3,
      "max": 16,
      "step": 0.1,
      "default": 7,
      "help": "Seconds between the waves that wash in"
    },
    {
      "key": "flowSpeed",
      "group": "flow",
      "label": "Current",
      "min": 0,
      "max": 3,
      "step": 0.01,
      "default": 0.8,
      "help": "How fast the stream flows (metres per second). Ripples and foam drift with the current, faster where the stream is narrow"
    },
    {
      "key": "flowFoam",
      "group": "flow",
      "label": "Rapids foam",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 0.4,
      "help": "Foam in fast, shallow water and behind stones"
    },
    {
      "key": "caustics",
      "group": "caustics",
      "label": "Strength",
      "min": 0,
      "max": 3,
      "step": 0.05,
      "default": 0.8,
      "help": "The sun's flickering net of light on the bottom, refracted by the waves"
    },
    {
      "key": "causticScale",
      "group": "caustics",
      "label": "Size",
      "min": 0.3,
      "max": 5,
      "step": 0.05,
      "default": 1.5,
      "help": "The size of the net's cells in metres"
    }
  ],
