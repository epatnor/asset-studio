    {"path": "spec.foliage.drapeDroop", "group": "drape", "label": "How fast they hang", "type": "number", "min": 0.5, "max": 8, "step": 0.1, "default": 3.5},
    {"path": "spec.foliage.drapeLength", "group": "drape", "label": "Length", "type": "number", "min": 0.4, "max": 2.5, "step": 0.05, "default": 1},
    {"path": "spec.foliage.drapeWidth", "group": "drape", "label": "Width", "type": "number", "min": 0.3, "max": 1.6, "step": 0.05, "default": 0.8},
    {"path": "spec.foliage.drapeRise", "group": "drape", "label": "Top height", "type": "number", "min": 0, "max": 1.2, "step": 0.05, "default": 0.5},
    {"path": "recipe.leaf_tint", "group": "color", "label": "Leaf color", "type": "color"},
    {"path": "spec.foliage.normalBlend", "group": "color", "label": "Rounded normals", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.9, "help": "1 = the ball is shaded as a soft volume"},
