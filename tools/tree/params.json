    {"path": "spec.foliage.cardSize", "group": "cards", "label": "Card size (m)", "type": "number", "min": 0.4, "max": 4, "step": 0.05, "default": 1.7, "help": "Bigger cards = bigger leaves. Hanging cards: the length of the curtain"},
    {"path": "spec.foliage.cardOffset", "group": "cards", "label": "Cards out toward the edge", "type": "number", "min": 0, "max": 1, "step": 0.01, "help": "0 = cards gather in the middle (soft, see-through edge), 1 = out at the surface (fluffy, full edge)"},
    {"path": "spec.foliage.cardGroup", "group": "cards", "label": "Card layout", "type": "select", "options": {"Single cards": "", "Crossed in threes": 3, "Hanging": "hang", "Drapery (birch)": "drape"}, "default": "", "help": "How the cards are put together. Crossed in threes reads as a round bunch from every side"},
    {"path": "spec.foliage.tipBall", "group": "tips", "label": "Tip ball size (m)", "type": "number", "min": 0, "max": 1.5, "step": 0.05, "default": 0, "help": "0 = off"},
    {"path": "spec.foliage.tipCover", "group": "tips", "label": "Which tips", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0, "help": "0 = every tip gets a ball, 1 = only tips outside the big balls"},
    {"path": "spec.foliage.cardWidth", "group": "advanced", "label": "Card width (m)", "type": "number", "min": 0.3, "max": 4, "step": 0.05, "fallback": "spec.foliage.cardSize", "help": "Follows the card size until you move it. Narrower or wider than the size stretches the leaves"},
