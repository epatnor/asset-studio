{
  "_doc": "Spakarna för träd i Asset Studio (docs/asset-studio.md). path: var värdet bor. spec.* = arten (som i species.json; skickas som species/canopy i receptet), recipe.* = receptets fält, view.* = bara visningen (ändras direkt i shadern, trädet byggs inte om). Standardvärdet tas från arten; default används om arten saknar värdet. type: number, int, bool, select, color, seed, texture, intrange (heltalsintervall [min, max]; spaken styr min och behåller bredden). fallback: en annan spaks sökväg vars värde visas så länge den här inte är satt. parts: panelens kort (en tillgång med flera delar, t.ex. krona och stam, får ett kort per del); groups hör till en part, och when visar gruppen bara när en annan spak har ett visst värde. hero: texturen visas stort överst i sitt kort. kinds: flikarna i studions header (vilka arter varje flik visar och standardhöjd; soon = kommer senare; generator: en annan generator än träden, med egna spakar, t.ex. prop för stenarna i tools/props/params.json). kinds på en part: kortet visas bara under de flikarna. kinds på en spak: spaken visas bara under de flikarna. when på en spak: spaken visas bara när en annan spak har ett visst värde ({path, equals}) eller inte har det ({path, not}). invert: ett av/på-reglage som visar motsatsen till värdet (Stam på = stemless false). start på en flik: namnet på en sparad tillgång i biblioteket (assets/trees/<namn>/recipe.json) som fliken startar med.",
  "generator": "tree",
  "label": "Trees and bushes",
  "kinds": [
    {"id": "tree", "label": "Tree", "species": ["cardtree", "cardbirch", "fir"], "height": 8, "start": "oak"},
    {"id": "bush", "label": "Bush", "species": ["cardbush"], "height": 1.5, "start": "bush_round"},
    {"id": "rock", "label": "Stone", "generator": "prop", "species": ["rock", "rock_mossy", "boulder_lowpoly", "boulder_mossy", "rock_slab", "standing_stone", "rock_cluster", "basalt"], "height": 1.2},
    {"id": "prop", "label": "Prop", "soon": true},
    {"id": "part", "label": "Building part", "soon": true}
  ],
  "species": [
    "cardtree",
    "cardbirch",
    "cardbush",
    "fir"
  ],
  "parts": [
    {"id": "asset", "label": "Tree", "accent": "#5b6b52", "kinds": ["tree", "bush"]},
    {"id": "crown", "label": "Crown", "accent": "#4e8a2f", "kinds": ["tree", "bush"]},
    {"id": "trunk", "label": "Trunk", "accent": "#7a4e2d", "kinds": ["tree", "bush"]},
    {"id": "render", "label": "Rendering and shadows", "accent": "#3d5a80"},
    {"id": "view", "label": "Display (changes instantly)", "accent": "#6b7280"}
  ],
  "groups": [
    {"id": "form", "part": "asset", "label": "Species and shape", "open": true},
    {"id": "crown", "part": "crown", "label": "Leaf balls", "open": true, "help": "The crown is built from leaf balls sitting on the twigs. Each ball is a bunch of flat leaf cards."},
    {"id": "cards", "part": "crown", "label": "Leaf cards", "open": true, "help": "The cards inside each ball, with the leaf sheet painted on them."},
    {"id": "tips", "part": "crown", "label": "Bare twig tips", "help": "Small extra balls for branch tips that poke out of the crown."},
    {"id": "drape", "part": "crown", "label": "Drapery", "open": true, "when": {"path": "spec.foliage.cardGroup", "equals": "drape"}},
    {"id": "color", "part": "crown", "label": "Light and color"},
    {"id": "advanced", "part": "crown", "label": "Advanced"},
    {"id": "trunk", "part": "trunk", "label": "Trunk shape", "open": true},
    {"id": "branches", "part": "trunk", "label": "Branches"},
    {"id": "blend", "part": "trunk", "label": "Bark and growth"},
    {"id": "shadows", "part": "render", "label": "Shadows", "open": true},
    {"id": "post", "part": "render", "label": "Light and post-processing", "open": true},
    {"id": "view", "part": "view", "label": "Display", "open": true}
  ],
  "params": [
    {"path": "recipe.leaves", "group": "crown", "label": "Leaf sheet", "type": "texture", "kind": "leaves", "hero": true},
    {"path": "recipe.bark", "group": "trunk", "label": "Bark", "type": "texture", "kind": "bark", "hero": true},
    {"path": "recipe.preset", "group": "form", "label": "Species", "type": "select", "options": {"Broadleaf (card balls)": "cardtree", "Birch (drapery)": "cardbirch", "Bush (card balls)": "cardbush"}},
    {"path": "recipe.height", "group": "form", "label": "Height (m)", "type": "number", "min": 1, "max": 20, "step": 0.5, "default": 8},
    {"path": "recipe.seed", "group": "form", "label": "Seed", "type": "seed", "default": 47},
    {"path": "spec.stemless", "group": "form", "label": "Trunk", "type": "bool", "invert": true, "default": false, "kinds": ["bush"], "help": "Off: the bush is just foliage resting on the ground; the skeleton still decides where the balls sit"},
    {"path": "spec.foliage.groundLift", "group": "form", "label": "Height above ground (m)", "type": "number", "min": 0, "max": 2, "step": 0.05, "default": 0, "kinds": ["bush"], "when": {"path": "spec.stemless", "equals": true}, "help": "Lifts the bush: the upper balls follow at once, the lower ones leave the ground only when the lift reaches them"},
    {"path": "recipe.bole", "group": "trunk", "label": "Trunk height (m)", "type": "number", "min": 0, "max": 12, "step": 0.1, "default": 0, "kinds": ["tree"], "help": "Height of the bare trunk up to the lowest branch. The crown keeps its size, so the tree gets taller or shorter. 0 = as the species gives"},
    {"path": "spec.trunk.length", "group": "trunk", "label": "Length (share)", "type": "number", "min": 0.15, "max": 1.0, "step": 0.01, "help": "The trunk's length before it splits"},
    {"path": "spec.trunk.radius", "group": "trunk", "label": "Thickness", "type": "number", "min": 0.015, "max": 0.14, "step": 0.002},
    {"path": "spec.trunk.gnarl", "group": "trunk", "label": "Crookedness", "type": "number", "min": 0, "max": 0.4, "step": 0.01},
    {"path": "spec.trunk.bend", "group": "trunk", "label": "Bend", "type": "number", "min": 0, "max": 0.6, "step": 0.01},
    {"path": "spec.trunk.bendFreq", "group": "trunk", "label": "Bend wavelength", "type": "number", "min": 0.3, "max": 2.5, "step": 0.05, "default": 1.5},
    {"path": "spec.trunk.twist", "group": "trunk", "label": "Twist", "type": "number", "min": 0, "max": 3, "step": 0.05},
    {"path": "spec.trunk.flare", "group": "trunk", "label": "Flare at the root", "type": "number", "min": 0, "max": 1.2, "step": 0.05},
    {"path": "spec.trunk.roots", "group": "trunk", "label": "Roots", "type": "int", "min": 0, "max": 8},
    {"path": "spec.trunk.lobes", "group": "trunk", "label": "Lobes", "type": "int", "min": 0, "max": 6},
    {"path": "spec.trunk.lobeAmp", "group": "trunk", "label": "Lobe depth", "type": "number", "min": 0, "max": 0.4, "step": 0.01},
    {"path": "spec.growth", "group": "branches", "label": "Growth", "type": "select", "options": {"In levels (classic)": "levels", "Grown toward the light": "colonize"}, "default": "levels", "help": "In levels: main branches, side branches and twigs at set angles. Grown: the branches grow step by step toward points spread in the crown's shape (space colonization), so the crown is made by the branches, with natural gaps, and the thickness follows the pipe model (a branch is as thick as its children together)"},
    {"path": "spec.colonize.shape", "group": "branches", "label": "Crown shape", "type": "select", "options": {"Round": "round", "Oval": "oval", "Conical": "conical", "Umbrella": "umbrella", "Columnar": "columnar", "Weeping": "weeping", "Irregular": "irregular"}, "default": "round", "when": {"path": "spec.growth", "equals": "colonize"}},
    {"path": "spec.colonize.width", "group": "branches", "label": "Crown width", "type": "number", "min": 0.2, "max": 1.0, "step": 0.01, "default": 0.5, "when": {"path": "spec.growth", "equals": "colonize"}, "help": "The crown's radius as a share of the tree's height"},
    {"path": "spec.colonize.crownStart", "group": "branches", "label": "Crown starts at", "type": "number", "min": 0.1, "max": 0.8, "step": 0.01, "default": 0.38, "when": {"path": "spec.growth", "equals": "colonize"}, "help": "Where the crown begins, as a share of the height"},
    {"path": "spec.colonize.points", "group": "branches", "label": "Branchiness", "type": "int", "min": 150, "max": 2000, "default": 700, "when": {"path": "spec.growth", "equals": "colonize"}, "help": "How many growth points the crown holds: more gives more and finer branches"},
    {"path": "spec.colonize.gaps", "group": "branches", "label": "Gaps", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.3, "when": {"path": "spec.growth", "equals": "colonize"}, "help": "Holes in the crown where no branches grow (readable negative space)"},
    {"path": "spec.colonize.irregular", "group": "branches", "label": "Irregularity", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.35, "when": {"path": "spec.growth", "equals": "colonize"}, "help": "How lopsided and lobed the crown is around the trunk"},
    {"path": "spec.colonize.tropism", "group": "branches", "label": "Reach for light", "type": "number", "min": -0.2, "max": 0.5, "step": 0.01, "default": 0.12, "when": {"path": "spec.growth", "equals": "colonize"}, "help": "How much the branches turn upward as they grow"},
    {"path": "spec.colonize.gravity", "group": "branches", "label": "Droop", "type": "number", "min": 0, "max": 0.8, "step": 0.01, "default": 0, "when": {"path": "spec.growth", "equals": "colonize"}, "help": "How much the branches hang down (weeping crowns droop on their own)"},
    {"path": "spec.colonize.influence", "group": "branches", "label": "Reach", "type": "number", "min": 0.08, "max": 0.4, "step": 0.01, "default": 0.22, "when": {"path": "spec.growth", "equals": "colonize"}, "adv": true, "help": "How far a growth point can pull a branch: short reach gives many small branches, long reach fewer long ones"},
    {"path": "spec.colonize.pipe", "group": "branches", "label": "Thickness rule", "type": "number", "min": 1.6, "max": 3, "step": 0.05, "default": 2.0, "when": {"path": "spec.growth", "equals": "colonize"}, "adv": true, "help": "The pipe model's exponent: 2 is da Vinci's rule (the trunk as thick as all branches together). Higher keeps the twigs thicker"},
    {"path": "spec.levels.0.count", "group": "branches", "label": "Main branches", "type": "intrange", "min": 1, "max": 14, "when": {"path": "spec.growth", "not": "colonize"}},
    {"path": "spec.levels.0.angle.0", "group": "branches", "label": "Main branch angle (°)", "type": "number", "min": 5, "max": 85, "step": 1, "when": {"path": "spec.growth", "not": "colonize"}},
    {"path": "spec.levels.0.length", "group": "branches", "label": "Main branch length", "type": "number", "min": 0.2, "max": 2, "step": 0.05, "when": {"path": "spec.growth", "not": "colonize"}},
    {"path": "spec.levels.0.start", "group": "branches", "label": "Starts on the trunk", "type": "number", "min": 0, "max": 0.95, "step": 0.01, "when": {"path": "spec.growth", "not": "colonize"}},
    {"path": "spec.levels.0.gravity", "group": "branches", "label": "Droop (gravity)", "type": "number", "min": -0.2, "max": 0.4, "step": 0.01, "when": {"path": "spec.growth", "not": "colonize"}},
    {"path": "spec.levels.1.count", "group": "branches", "label": "Side branches", "type": "intrange", "min": 1, "max": 10, "when": {"path": "spec.growth", "not": "colonize"}},
    {"path": "spec.levels.1.length", "group": "branches", "label": "Side branch length", "type": "number", "min": 0.1, "max": 1.5, "step": 0.05, "when": {"path": "spec.growth", "not": "colonize"}},
    {"path": "spec.foliage.clusters", "group": "crown", "label": "Number of balls", "type": "int", "min": 1, "max": 16, "help": "How many balls the twigs are grouped into. Few = big soft masses, many = a lumpy crown"},
    {"path": "spec.foliage.ballSpread", "group": "crown", "label": "Spread balls apart", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0, "help": "Moves each ball out toward the outer twigs of its group: gaps open between the balls and the crown gets wider and lumpier"},
    {"path": "spec.foliage.ballScale", "group": "crown", "label": "Ball size", "type": "number", "min": 0.8, "max": 3, "step": 0.05, "help": "How big each ball is around its twigs. Bigger = the balls merge into one full crown"},
    {"path": "spec.foliage.minBall", "group": "crown", "label": "Smallest ball", "type": "number", "min": 0.03, "max": 0.3, "step": 0.01, "help": "No ball gets smaller than this, as a share of the tree height"},
