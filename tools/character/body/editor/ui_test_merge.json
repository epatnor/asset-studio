{
 "_doc": "Provar Merge: en rad på ena sidan med spegling, en rad över mitten, utan spegling, på en öppen halva, och Undo. Öppnar grundnätet och sparar inget.",
 "name": "body_editor_merge",
 "url": "http://127.0.0.1:8772/",
 "size": [
  1600,
  1000
 ],
 "steps": [
  {
   "until": "window.editorState && document.getElementById('versions')?.options.length > 0",
   "timeout": 30000
  },
  {
   "wait": 800
  },
  {
   "eval": "(() => { const select = document.getElementById('versions'); select.value = '__base'; select.dispatchEvent(new Event('change')); window.st = () => ({status: document.getElementById('status').textContent, faces: window.editorState.faces, selected: window.editorState.selectedPoints, closed: window.editorState.closed()}); window.row = (x, y, z) => { window.p = window.editorState.pickPoint(x, y, z); return window.p; }; return true; })()"
  },
  {
   "wait": 400
  },
  {
   "click": "Point",
   "in": "#tools button"
  },
  {
   "eval": "window.f0 = window.editorState.faces, window.row(0.08, 0.65, 0.09)"
  },
  {
   "drag": "(() => [[window.p.x, window.p.y], [window.p.x, window.p.y]])()",
   "button": "right"
  },
  {
   "wait": 100
  },
  {
   "click": "Select row",
   "in": "#menu button"
  },
  {
   "wait": 100
  },
  {
   "eval": "window.n = window.editorState.selectedPoints"
  },
  {
   "click": "Merge",
   "in": "#pointPanel button"
  },
  {
   "wait": 150
  },
  {
   "eval": "window.st()"
  },
  {
   "expect": "/into one on each side/.test(document.getElementById('status').textContent) && window.editorState.selectedPoints === 1",
   "label": "a leg row with mirror merges into one point on each side"
  },
  {
   "shot": "1_leg",
   "minLight": 25
  },
  {
   "click": "Undo",
   "in": "button"
  },
  {
   "wait": 150
  },
  {
   "expect": "window.editorState.faces === window.f0 && window.editorState.closed()",
   "label": "Undo restores it"
  },
  {
   "eval": "window.row(0, 1.12, 0.13)"
  },
  {
   "drag": "(() => [[window.p.x, window.p.y], [window.p.x, window.p.y]])()",
   "button": "right"
  },
  {
   "wait": 100
  },
  {
   "click": "Select row",
   "in": "#menu button"
  },
  {
   "wait": 100
  },
  {
   "eval": "window.n = window.editorState.selectedPoints"
  },
  {
   "key": "m"
  },
  {
   "wait": 200
  },
  {
   "eval": "window.st()"
  },
  {
   "expect": "window.editorState.selectedPoints === 1 && /into one\\./.test(document.getElementById('status').textContent)",
   "label": "a whole waist ring merges into one middle point, key M"
  },
  {
   "click": "Undo",
   "in": "button"
  },
  {
   "wait": 150
  },
  {
   "eval": "document.getElementById('mirror').click(), window.row(0.08, 0.65, 0.09)"
  },
  {
   "drag": "(() => [[window.p.x, window.p.y], [window.p.x, window.p.y]])()",
   "button": "right"
  },
  {
   "wait": 100
  },
  {
   "click": "Select row",
   "in": "#menu button"
  },
  {
   "wait": 100
  },
  {
   "drag": "(() => [[window.p.x, window.p.y], [window.p.x, window.p.y]])()",
   "button": "right"
  },
  {
   "wait": 100
  },
  {
   "click": "Merge at this point",
   "in": "#menu button"
  },
  {
   "wait": 150
  },
  {
   "eval": "window.st()"
  },
  {
   "expect": "/Merged/.test(document.getElementById('status').textContent) && window.editorState.selectedPoints === 1",
   "label": "Merge at this point without mirror"
  },
  {
   "click": "Undo",
   "in": "button"
  },
  {
   "wait": 150
  },
  {
   "eval": "document.getElementById('mirror').click(), true"
  },
  {
   "drag": "(() => { const [x, y] = window.editorState.screenOfBody(0.08, 0.65, 0.09); return [[x, y], [x, y]]; })()",
   "button": "right"
  },
  {
   "wait": 100
  },
  {
   "click": "Delete the other half",
   "in": "#menu button"
  },
  {
   "wait": 150
  },
  {
   "eval": "window.row(0.08, 0.65, 0.09)"
  },
  {
   "drag": "(() => [[window.p.x, window.p.y], [window.p.x, window.p.y]])()",
   "button": "right"
  },
  {
   "wait": 100
  },
  {
   "click": "Select row",
   "in": "#menu button"
  },
  {
   "wait": 100
  },
  {
   "click": "Merge",
   "in": "#pointPanel button"
  },
  {
   "wait": 150
  },
  {
   "eval": "window.st()"
  },
  {
   "expect": "/Merged/.test(document.getElementById('status').textContent)",
   "label": "merging works on an open half"
  },
  {
   "expect": "document.getElementById('poses').hidden",
   "label": "the pose row is hidden"
  }
 ]
}