{
 "_doc": "Dragning med spegling: båda sidor markerade behåller bredden, en sida ändrar den, utan spegling flyttas allt i sidled. Öppnar grundnätet och sparar inget.",
 "name": "body_editor_mirror_drag",
 "url": "http://127.0.0.1:8772/",
 "size": [
  1600,
  1000
 ],
 "steps": [
  {
   "until": "window.editorState && document.getElementById('versions')?.options.length > 0",
   "timeout": 30000
  },
  {
   "wait": 800
  },
  {
   "eval": "(() => { const select = document.getElementById('versions'); select.value = '__base'; select.dispatchEvent(new Event('change')); return true; })()"
  },
  {
   "wait": 400
  },
  {
   "click": "Point",
   "in": "#tools button"
  },
  {
   "eval": "(window.p = window.editorState.pickPoint(0.1, 1.12, 0.12), window.p)"
  },
  {
   "drag": "(() => [[window.p.x, window.p.y], [window.p.x, window.p.y]])()",
   "button": "right"
  },
  {
   "wait": 100
  },
  {
   "click": "Select row",
   "in": "#menu button"
  },
  {
   "wait": 100
  },
  {
   "eval": "(window.b0 = window.editorState.selectionBox, window.b0)"
  },
  {
   "expect": "window.editorState.selectedPoints >= 8 && window.b0.width > 0.05",
   "label": "a waist row crosses the middle"
  },
  {
   "drag": "(() => { const q = window.p; return [[q.x, q.y], [q.x + 70, q.y - 45]]; })()"
  },
  {
   "wait": 150
  },
  {
   "eval": "window.editorState.selectionBox"
  },
  {
   "expect": "Math.abs(window.editorState.selectionBox.width - window.b0.width) < 1e-6",
   "label": "a diagonal drag across the middle keeps the width"
  },
  {
   "expect": "window.editorState.selectionBox.meanY > window.b0.meanY + 0.01",
   "label": "it still moves up"
  },
  {
   "expect": "/keeps its width/.test(document.getElementById('status').textContent)",
   "label": "the status says why"
  },
  {
   "click": "Undo",
   "in": "button"
  },
  {
   "wait": 100
  },
  {
   "eval": "document.getElementById('moveModes').querySelector('button:nth-child(2)').click(), window.b0.width"
  },
  {
   "key": "Escape"
  },
  {
   "click": "Free",
   "in": "#moveModes button"
  },
  {
   "eval": "(window.p = window.editorState.pickPoint(0.08, 0.65, 0.09), window.p)"
  },
  {
   "drag": "(() => [[window.p.x, window.p.y], [window.p.x, window.p.y]])()",
   "button": "right"
  },
  {
   "wait": 100
  },
  {
   "click": "Clear selection",
   "in": "#menu button"
  },
  {
   "wait": 50
  },
  {
   "drag": "(() => [[window.p.x, window.p.y], [window.p.x, window.p.y]])()",
   "button": "right"
  },
  {
   "wait": 100
  },
  {
   "key": "Escape"
  },
  {
   "eval": "(window.p = window.editorState.pickPoint(0.08, 0.65, 0.09), window.p)"
  },
  {
   "drag": "(() => [[window.p.x, window.p.y], [window.p.x, window.p.y]])()",
   "button": "right"
  },
  {
   "wait": 100
  },
  {
   "eval": "(window.editorState.menuOpen && document.querySelector('#menu').setAttribute('hidden', ''), window.b0 = window.editorState.selectionBox, window.b0)"
  },
  {
   "drag": "(() => { const q = window.p; return [[q.x, q.y], [q.x + 70, q.y - 45]]; })()"
  },
  {
   "wait": 150
  },
  {
   "eval": "window.editorState.selectionBox"
  },
  {
   "expect": "Math.abs(window.editorState.selectionBox.width - window.b0.width) > 0.005",
   "label": "a single point on one side still moves sideways"
  },
  {
   "click": "Undo",
   "in": "button"
  },
  {
   "wait": 100
  },
  {
   "eval": "(window.p = window.editorState.pickPoint(0.08, 0.65, 0.09), window.p)"
  },
  {
   "drag": "(() => [[window.p.x, window.p.y], [window.p.x, window.p.y]])()",
   "button": "right"
  },
  {
   "wait": 100
  },
  {
   "click": "Select row",
   "in": "#menu button"
  },
  {
   "wait": 100
  },
  {
   "eval": "(window.b0 = window.editorState.selectionBox, window.b0)"
  },
  {
   "drag": "(() => { const q = window.p; return [[q.x, q.y], [q.x + 70, q.y - 45]]; })()"
  },
  {
   "wait": 150
  },
  {
   "eval": "window.editorState.selectionBox"
  },
  {
   "expect": "Math.abs(window.editorState.selectionBox.width - window.b0.width) > 0.005",
   "label": "a leg row still moves sideways"
  },
  {
   "expect": "!/keeps its width/.test(document.getElementById('status').textContent)",
   "label": "no lock message for the leg"
  }
 ]
}