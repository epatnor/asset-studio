{
 "_doc": "Provar buren runt markeringen: sidor, hörn, jämn skalning, mitten, spegling, Undo och Esc. Öppnar yvonne_v8 och sparar inget.",
 "name": "body_editor_cage",
 "url": "http://127.0.0.1:8772/",
 "size": [
  1600,
  1000
 ],
 "steps": [
  {
   "until": "window.editorState && document.getElementById('versions')?.options.length > 0",
   "timeout": 30000
  },
  {
   "wait": 800
  },
  {
   "eval": "(() => { const select = document.getElementById('versions'); select.value = 'yvonne_v8'; select.dispatchEvent(new Event('change')); document.getElementById('versionLoad').click(); return true; })()"
  },
  {
   "wait": 400
  },
  {
   "click": "Front",
   "in": "#views button"
  },
  {
   "wait": 200
  },
  {
   "click": "Faces",
   "in": "#tools button"
  },
  {
   "click": "Head",
   "in": "#facePanel button"
  },
  {
   "wait": 50
  },
  {
   "key": "b"
  },
  {
   "wait": 100
  },
  {
   "expect": "window.editorState.cageOpen && window.editorState.cageSymmetric",
   "label": "B opens a symmetric cage around the head"
  },
  {
   "shot": "1_cage",
   "minLight": 25
  },
  {
   "eval": "(window.b = window.editorState.cagePointsBox, window.b)"
  },
  {
   "drag": "(() => { const [x, y] = window.editorState.cageScreen(11); return [[x, y], [x + 0, y + -40]]; })()"
  },
  {
   "wait": 150
  },
  {
   "eval": "window.editorState.cagePointsBox"
  },
  {
   "expect": "window.editorState.cagePointsBox.y[1] > window.b.y[1] + 0.01 && Math.abs(window.editorState.cagePointsBox.y[0] - window.b.y[0]) < 1e-4",
   "label": "the top side stretches up and the bottom stays"
  },
  {
   "expect": "Math.abs(window.editorState.cagePointsBox.x[1] - window.b.x[1]) < 1e-6",
   "label": "the width stays"
  },
  {
   "eval": "(window.b = window.editorState.cagePointsBox, window.b)"
  },
  {
   "drag": "(() => { const [x, y] = window.editorState.cageScreen(9); return [[x, y], [x + 50, y + 0]]; })()"
  },
  {
   "wait": 150
  },
  {
   "eval": "window.editorState.cagePointsBox"
  },
  {
   "expect": "window.editorState.cagePointsBox.x[1] > window.b.x[1] + 0.01 && Math.abs(window.editorState.cagePointsBox.x[1] + window.editorState.cagePointsBox.x[0]) < 1e-4",
   "label": "a side widens both halves evenly"
  },
  {
   "expect": "window.editorState.cagePointsBox.center < 1e-9 && window.editorState.cageTwinError < 5e-5",
   "label": "the middle stays on the middle and twins match"
  },
  {
   "eval": "(window.b = window.editorState.cagePointsBox, window.b)"
  },
  {
   "drag": "(() => { const [x, y] = window.editorState.cageScreen(0); return [[x, y], [x + -30, y + 30]]; })()"
  },
  {
   "wait": 150
  },
  {
   "eval": "window.editorState.cagePointsBox"
  },
  {
   "eval": "window.editorState.cageOuter"
  },
  {
   "expect": "window.editorState.cageOuter.count > 5 && window.editorState.cageOuter.maxMoved > 0.001",
   "label": "points outside the box follow along"
  },
  {
   "expect": "window.editorState.cageOuter.farMoved < window.editorState.cageOuter.maxMoved * 0.5",
   "label": "the far ones follow less"
  },
  {
   "expect": "window.editorState.cageTwinError < 5e-5",
   "label": "a corner bends the shape on both sides"
  },
  {
   "shot": "2_bent",
   "minLight": 25
  },
  {
   "key": "b"
  },
  {
   "key": "b"
  },
  {
   "wait": 100
  },
  {
   "eval": "(window.b = window.editorState.cagePointsBox, window.b)"
  },
  {
   "drag": "(() => { const [x, y] = window.editorState.cageScreen(7); return [[x, y], [x + 40, y + -40]]; })()",
   "modifiers": [
    "shift"
   ]
  },
  {
   "wait": 150
  },
  {
   "eval": "window.editorState.cagePointsBox"
  },
  {
   "expect": "(() => { const n = window.editorState.cagePointsBox, b = window.b; const s = k => (n[k][1] - n[k][0]) / (b[k][1] - b[k][0]); return s('x') > 1.05 && Math.abs(s('x') - s('y')) < 1e-3 && Math.abs(s('y') - s('z')) < 1e-3; })()",
   "label": "shift on a corner scales evenly"
  },
  {
   "eval": "(window.b = window.editorState.cagePointsBox, window.b)"
  },
  {
   "drag": "(() => { const [x, y] = window.editorState.cageScreen(14); return [[x, y], [x + 70, y + -40]]; })()"
  },
  {
   "wait": 150
  },
  {
   "eval": "window.editorState.cagePointsBox"
  },
  {
   "eval": "({last: window.editorState.cageLastOp, status: document.getElementById('status').textContent})"
  },
  {
   "expect": "window.editorState.cagePointsBox.y[0] > window.b.y[0] + 0.01 && Math.abs(window.editorState.cagePointsBox.x[1] - window.b.x[1]) < 1e-6",
   "label": "the middle moves it up without sideways"
  },
  {
   "click": "Undo",
   "in": "button"
  },
  {
   "wait": 150
  },
  {
   "expect": "window.editorState.cageOpen && Math.abs(window.editorState.cagePointsBox.y[0] - window.b.y[0]) < 1e-4",
   "label": "Undo puts it back and the cage follows"
  },
  {
   "key": "Escape"
  },
  {
   "wait": 50
  },
  {
   "expect": "!window.editorState.cageOpen && window.editorState.selected > 0",
   "label": "Esc closes the cage and keeps the selection"
  },
  {
   "key": "Escape"
  },
  {
   "click": "Point",
   "in": "#tools button"
  },
  {
   "eval": "(window.p = window.editorState.pickPoint(0.08, 0.65, 0.09), window.q = window.editorState.pickPoint(0.09, 0.5, 0.09), true)"
  },
  {
   "drag": "(() => [[window.p.x, window.p.y], [window.p.x, window.p.y]])()"
  },
  {
   "drag": "(() => [[window.q.x, window.q.y], [window.q.x, window.q.y]])()",
   "modifiers": [
    "shift"
   ]
  },
  {
   "wait": 50
  },
  {
   "click": "Cage",
   "in": "#pointPanel button"
  },
  {
   "wait": 100
  },
  {
   "eval": "({open: window.editorState.cageOpen, symmetric: window.editorState.cageSymmetric, points: window.editorState.selectedPoints})"
  },
  {
   "expect": "window.editorState.cageOpen && !window.editorState.cageSymmetric",
   "label": "points on one side get a one-sided cage"
  },
  {
   "eval": "(window.b = window.editorState.cagePointsBox, window.b)"
  },
  {
   "drag": "(() => { const [x, y] = window.editorState.cageScreen(9); return [[x, y], [x + 40, y + 0]]; })()"
  },
  {
   "wait": 150
  },
  {
   "expect": "window.editorState.cagePointsBox.x[1] > window.b.x[1] + 0.005 && window.editorState.cageTwinError < 5e-5",
   "label": "their twins follow, mirrored"
  }
 ]
}