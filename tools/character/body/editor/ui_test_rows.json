{
  "_doc": "Provar rader och kolumner av punkter (se ui_test.json). Öppnar grundnätet och sparar inget.",
  "name": "body_editor_rows",
  "url": "http://127.0.0.1:8772/",
  "size": [1600, 1000],
  "steps": [
    {"until": "window.editorState && document.getElementById('versions')?.options.length > 0", "timeout": 30000},
    {"wait": 800},
    {"eval": "(() => { const select = document.getElementById('versions'); select.value = '__base'; select.dispatchEvent(new Event('change')); return true; })()"},
    {"wait": 500},
    {"click": "Point", "in": "#tools button"},
    {"eval": "(() => { window.p = window.editorState.pickPoint(0.07, 1.10, 0.11); return window.p; })()"},
    {"drag": "(() => [[window.p.x, window.p.y], [window.p.x, window.p.y]])()"},
    {"expect": "window.editorState.selectedPoints === 1", "label": "a click selects one point"},
    {"click": "Row", "in": "#pointPanel button"},
    {"eval": "window.editorState.selectedPoints"},
    {"expect": "window.editorState.selectedPoints >= 10", "label": "Row selects the whole row"},
    {"shot": "1_row", "minLight": 25},
    {"click": "None", "in": "#pointPanel button"},
    {"expect": "window.editorState.selectedPoints === 0", "label": "None clears"},

    {"drag": "(() => [[window.p.x, window.p.y], [window.p.x, window.p.y]])()"},
    {"click": "Column", "in": "#pointPanel button"},
    {"eval": "window.editorState.selectedPoints"},
    {"expect": "window.editorState.selectedPoints >= 10", "label": "Column selects the whole column"},
    {"shot": "2_column", "minLight": 25},
    {"click": "None", "in": "#pointPanel button"},

    {"drag": "(() => [[window.p.x, window.p.y], [window.p.x, window.p.y]])()", "modifiers": ["shift", "ctrl"]},
    {"eval": "window.editorState.selectedPoints"},
    {"expect": "window.editorState.selectedPoints >= 10", "label": "Shift+Ctrl-click selects the row"},

    {"click": "In / Out", "in": "#moveModes button"},
    {"drag": "(() => [[window.p.x, window.p.y], [window.p.x, window.p.y - 10], [window.p.x, window.p.y - 20]])()"},
    {"eval": "window.editorState.movedAlongNormal(window.p.v)"},
    {"expect": "window.editorState.movedAlongNormal(window.p.v).along > 0.01", "label": "the whole row moves out with In / Out"},
    {"expect": "window.editorState.closed()", "label": "the mesh stays closed"},
    {"shot": "3_row_out", "minLight": 25},
    {"click": "Undo", "in": "button"},
    {"click": "Free", "in": "#moveModes button"}
  ]
}
