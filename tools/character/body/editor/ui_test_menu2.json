{
 "_doc": "Provar resten av högerklicksmenyn: sammanfoga, jämna ut, till mitten, kopiera, ny punkt, ta bort kant, loop cut, anteckning. Öppnar grundnätet och sparar inget.",
 "name": "body_editor_menu2",
 "url": "http://127.0.0.1:8772/",
 "size": [
  1600,
  1000
 ],
 "steps": [
  {
   "until": "window.editorState && document.getElementById('versions')?.options.length > 0",
   "timeout": 30000
  },
  {
   "wait": 800
  },
  {
   "eval": "(() => { const select = document.getElementById('versions'); select.value = '__base'; select.dispatchEvent(new Event('change')); window.at = (x, y, z) => { const [a, b] = window.editorState.screenOfBody(x, y, z); return [[a, b], [a, b]]; }; window.st = () => ({status: document.getElementById('status').textContent, faces: window.editorState.faces, closed: window.editorState.closed()}); return true; })()"
  },
  {
   "wait": 400
  },
  {
   "click": "Point",
   "in": "#tools button"
  },
  {
   "eval": "(() => { window.f0 = window.editorState.faces; const p = window.editorState.pickPoint(0.08, 0.65, 0.09); window.p = p; return p; })()"
  },
  {
   "drag": "(() => [[window.p.x, window.p.y], [window.p.x, window.p.y]])()",
   "button": "right"
  },
  {
   "wait": 100
  },
  {
   "click": "Smooth",
   "in": "#menu button"
  },
  {
   "wait": 100
  },
  {
   "eval": "window.st()"
  },
  {
   "expect": "/Smoothed 1 points/.test(document.getElementById('status').textContent)",
   "label": "Smooth"
  },
  {
   "drag": "(() => [[window.p.x, window.p.y], [window.p.x, window.p.y]])()",
   "button": "right"
  },
  {
   "wait": 100
  },
  {
   "click": "Copy to the other side",
   "in": "#menu button"
  },
  {
   "wait": 100
  },
  {
   "eval": "window.st()"
  },
  {
   "expect": "/twins to match|no twins/.test(document.getElementById('status').textContent)",
   "label": "Copy to the other side"
  },
  {
   "click": "Edges",
   "in": "#tools button"
  },
  {
   "drag": "(() => window.at(0.08, 0.65, 0.09))()",
   "button": "right"
  },
  {
   "wait": 100
  },
  {
   "eval": "window.editorState.menuLabels.slice(0, 9)"
  },
  {
   "click": "Add a point here",
   "in": "#menu button"
  },
  {
   "wait": 150
  },
  {
   "eval": "window.st()"
  },
  {
   "expect": "/Added a point/.test(document.getElementById('status').textContent) && window.editorState.closed()",
   "label": "Add a point keeps it closed"
  },
  {
   "drag": "(() => window.at(0.08, 0.72, 0.09))()",
   "button": "right"
  },
  {
   "wait": 100
  },
  {
   "eval": "window.f1 = window.editorState.faces"
  },
  {
   "click": "Cut a loop here",
   "in": "#menu button"
  },
  {
   "wait": 150
  },
  {
   "eval": "window.st()"
  },
  {
   "expect": "window.editorState.faces > window.f1 && window.editorState.closed()",
   "label": "Cut a loop adds faces and stays closed"
  },
  {
   "drag": "(() => window.at(0.08, 0.72, 0.09))()",
   "button": "right"
  },
  {
   "wait": 100
  },
  {
   "eval": "window.f2 = window.editorState.faces"
  },
  {
   "click": "Remove this edge",
   "in": "#menu button"
  },
  {
   "wait": 150
  },
  {
   "eval": "window.st()"
  },
  {
   "expect": "window.editorState.faces < window.f2 && window.editorState.closed()",
   "label": "Remove this edge"
  },
  {
   "drag": "(() => window.at(0.08, 0.55, 0.09))()",
   "button": "right"
  },
  {
   "wait": 100
  },
  {
   "eval": "window.f3 = window.editorState.faces"
  },
  {
   "click": "Merge its two ends",
   "in": "#menu button"
  },
  {
   "wait": 150
  },
  {
   "eval": "window.st()"
  },
  {
   "expect": "/Merged 2 points|cannot be merged/.test(document.getElementById('status').textContent) && window.editorState.closed()",
   "label": "Merge its two ends stays closed or refuses"
  },
  {
   "key": "Escape"
  },
  {
   "click": "Faces",
   "in": "#tools button"
  },
  {
   "drag": "(() => window.at(0.08, 0.5, 0.09))()",
   "button": "right"
  },
  {
   "wait": 100
  },
  {
   "click": "Add a row",
   "in": "#menu button"
  },
  {
   "wait": 150
  },
  {
   "eval": "window.st()"
  },
  {
   "expect": "window.editorState.closed()",
   "label": "Add a row from the menu"
  },
  {
   "drag": "(() => window.at(0.08, 0.45, 0.09))()",
   "button": "right"
  },
  {
   "wait": 100
  },
  {
   "click": "Select ring",
   "in": "#menu button"
  },
  {
   "wait": 100
  },
  {
   "drag": "(() => window.at(0.08, 0.45, 0.09))()",
   "button": "right"
  },
  {
   "wait": 100
  },
  {
   "click": "Grow by a row",
   "in": "#menu button"
  },
  {
   "wait": 100
  },
  {
   "drag": "(() => window.at(0.08, 0.45, 0.09))()",
   "button": "right"
  },
  {
   "wait": 100
  },
  {
   "eval": "window.editorState.menuLabels.slice(0, 2)"
  },
  {
   "click": "Merge rows",
   "in": "#menu button"
  },
  {
   "wait": 150
  },
  {
   "eval": "window.st()"
  },
  {
   "expect": "window.editorState.closed()",
   "label": "Merge rows from the menu"
  },
  {
   "key": "Escape"
  },
  {
   "drag": "(() => window.at(0.08, 0.65, 0.09))()",
   "button": "right"
  },
  {
   "wait": 100
  },
  {
   "click": "Add a note",
   "in": "#menu button"
  },
  {
   "wait": 100
  },
  {
   "expect": "document.activeElement.id === 'noteText'",
   "label": "Add a note goes to the note box"
  },
  {
   "click": "Point",
   "in": "#tools button"
  },
  {
   "eval": "(() => { const c = window.editorState.pickPoint(0, 1.2, 0.13); return c; })()"
  },
  {
   "eval": "window.st()"
  },
  {
   "click": "Edges",
   "in": "#tools button"
  },
  {
   "drag": "(() => window.at(0.08, 0.8, 0.09))()",
   "button": "right"
  },
  {
   "wait": 100
  },
  {
   "click": "Delete the other half",
   "in": "#menu button"
  },
  {
   "wait": 150
  },
  {
   "expect": "!window.editorState.closed()",
   "label": "the half is open"
  },
  {
   "drag": "(() => window.at(0.1, 1.1, 0.1))()",
   "button": "right"
  },
  {
   "wait": 100
  },
  {
   "eval": "window.editorState.menuLabels.slice(0,3)"
  },
  {
   "click": "Merge its two ends",
   "in": "#menu button"
  },
  {
   "wait": 150
  },
  {
   "eval": "window.st()"
  },
  {
   "expect": "/Merged 2 points/.test(document.getElementById('status').textContent)",
   "label": "merging works on an open half"
  },
  {
   "click": "Point",
   "in": "#tools button"
  },
  {
   "eval": "(() => { window.p = window.editorState.pickPoint(0.1, 1.1, 0.1); return window.p; })()"
  },
  {
   "drag": "(() => [[window.p.x, window.p.y], [window.p.x, window.p.y]])()",
   "button": "right"
  },
  {
   "wait": 100
  },
  {
   "click": "Move to the middle",
   "in": "#menu button"
  },
  {
   "wait": 150
  },
  {
   "eval": "window.st()"
  },
  {
   "expect": "/to the middle/.test(document.getElementById('status').textContent)",
   "label": "Move to the middle"
  }
 ]
}