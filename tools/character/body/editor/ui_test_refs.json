{
  "_doc": "Provar platta vyer, referensbilder och versionslistan (se ui_test.json). Sparar ingen modell.",
  "name": "body_editor_refs",
  "url": "http://127.0.0.1:8772/",
  "size": [1600, 1100],
  "steps": [
    {"until": "window.editorState && document.getElementById('versions')?.options.length > 0", "timeout": 30000},
    {"wait": 1500},
    {"eval": "({faces: window.editorState.faces, versions: [...document.getElementById('versions').options].map(o => o.textContent), refs: window.editorState.referenceNames()})"},
    {"expect": "[...document.getElementById('versions').options].some(o => o.value === 'yvonne_robot_v4')", "label": "v4 is in the version list"},
    {"expect": "window.editorState.referenceNames().length === 4", "label": "her four views are loaded as references"},
    {"click": "Front", "in": "#views button"},
    {"wait": 400},
    {"expect": "window.editorState.flat === true && window.editorState.view === 'front'", "label": "the Front button gives a flat view"},
    {"expect": "window.editorState.referencesShown.length === 1", "label": "only the facing reference shows"},
    {"eval": "window.editorState.referenceFit('front')"},
    {"expect": "Math.abs(window.editorState.referenceFit('front').figure_top - window.editorState.referenceFit('front').body_top) < 0.03 && Math.abs(window.editorState.referenceFit('front').figure_bottom - window.editorState.referenceFit('front').body_bottom) < 0.03", "label": "the figure in the image fits the body height"},
    {"shot": "1_front", "minLight": 25},
    {"click": "Left", "in": "#views button"},
    {"wait": 400},
    {"expect": "window.editorState.view === 'left' && window.editorState.referencesShown.length === 1", "label": "the Left view shows its reference"},
    {"eval": "window.editorState.referenceFit('left')"},
    {"shot": "2_left", "minLight": 25},
    {"click": "Back", "in": "#views button"},
    {"wait": 400},
    {"shot": "3_back", "minLight": 25},
    {"key": "1"},
    {"wait": 200},
    {"expect": "window.editorState.view === 'front'", "label": "key 1 gives the front view"},
    {"click": "Point", "in": "#tools button"},
    {"eval": "(() => { window.p = window.editorState.pickPoint(0.10, 0.65, 0.09); return window.p; })()"},
    {"drag": "(() => [[window.p.x, window.p.y], [window.p.x + 10, window.p.y], [window.p.x + 20, window.p.y]])()"},
    {"eval": "window.editorState.pointAfter(window.p.v)"},
    {"expect": "window.editorState.pointAfter(window.p.v).moved > 0.01", "label": "a point can be moved in a flat view"},
    {"click": "Undo", "in": "button"},
    {"eval": "(() => { const select = document.getElementById('versions'); select.value = '__base'; select.dispatchEvent(new Event('change')); return true; })()"},
    {"wait": 600},
    {"eval": "({faces: window.editorState.faces})"},
    {"expect": "window.editorState.faces === 1982", "label": "the built body opens from the list"},
    {"eval": "(() => { const select = document.getElementById('versions'); select.value = 'yvonne_robot_v4'; select.dispatchEvent(new Event('change')); return true; })()"},
    {"wait": 800},
    {"eval": "({faces: window.editorState.faces, status: document.getElementById('status').textContent})"},
    {"expect": "document.getElementById('status').textContent.startsWith('Opened yvonne_robot_v4')", "label": "v4 opens from the list"},
    {"expect": "window.editorState.closed()", "label": "v4 is closed"},
    {"key": "5"},
    {"wait": 300},
    {"expect": "window.editorState.flat === false", "label": "key 5 returns to 3D"},
    {"shot": "4_3d", "minLight": 25}
  ]
}
