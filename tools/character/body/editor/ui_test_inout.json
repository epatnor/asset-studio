{
  "_doc": "Provar In/Out och See through (se ui_test.json). Öppnar grundnätet och sparar inget.",
  "name": "body_editor_inout",
  "url": "http://127.0.0.1:8772/",
  "size": [1600, 1100],
  "steps": [
    {"until": "window.editorState && document.getElementById('versions')?.options.length > 0", "timeout": 30000},
    {"wait": 1000},
    {"eval": "(() => { const select = document.getElementById('versions'); select.value = '__base'; select.dispatchEvent(new Event('change')); return true; })()"},
    {"wait": 500},
    {"click": "Point", "in": "#tools button"},
    {"click": "In / Out", "in": "#moveModes button"},
    {"eval": "(() => { window.p = window.editorState.pickPoint(0.08, 0.65, 0.09); return window.p; })()"},
    {"drag": "(() => [[window.p.x, window.p.y], [window.p.x, window.p.y - 15], [window.p.x, window.p.y - 30]])()"},
    {"eval": "window.editorState.movedAlongNormal(window.p.v)"},
    {"expect": "window.editorState.movedAlongNormal(window.p.v).along > 0.01", "label": "dragging up moves the point out"},
    {"expect": "window.editorState.movedAlongNormal(window.p.v).total < window.editorState.movedAlongNormal(window.p.v).along * 1.1", "label": "it moves almost only along the normal"},
    {"click": "Undo", "in": "button"},
    {"drag": "(() => [[window.p.x, window.p.y], [window.p.x, window.p.y + 15], [window.p.x, window.p.y + 30]])()"},
    {"expect": "window.editorState.movedAlongNormal(window.p.v).along < -0.01", "label": "dragging down moves the point in"},
    {"click": "Undo", "in": "button"},

    {"click": "Edges", "in": "#tools button"},
    {"drag": "(() => { const [x, y] = window.editorState.screenOfBody(0.03, 1.12, 0.13); return [[x, y], [x, y]]; })()", "modifiers": ["shift"]},
    {"eval": "window.editorState.selectedEdges"},
    {"expect": "window.editorState.selectedEdges >= 8", "label": "a loop is selected"},
    {"eval": "(() => { const [x, y] = window.editorState.screenOfBody(0.03, 1.12, 0.13); return [x, y]; })()"},
    {"drag": "(() => { const [x, y] = window.editorState.screenOfBody(0.03, 1.12, 0.13); return [[x, y], [x, y - 12], [x, y - 24]]; })()"},
    {"expect": "window.editorState.closed()", "label": "the mesh stays closed"},
    {"click": "Undo", "in": "button"},
    {"click": "Free", "in": "#moveModes button"},

    {"click": "Point", "in": "#tools button"},
    {"click": "Front", "in": "#views button"},
    {"wait": 300},
    {"click": "See through", "in": "label"},
    {"eval": "document.getElementById('through').checked"},
    {"eval": "(() => { window.q = window.editorState.pickPoint(0.08, 0.65, -0.09); return window.q; })()"},
    {"drag": "(() => [[window.q.x, window.q.y], [window.q.x, window.q.y]])()"},
    {"eval": "window.editorState.selectedPoints"},
    {"expect": "window.editorState.selectedPoints === 1", "label": "See through takes a point on the far side"},
    {"shot": "1_through", "minLight": 25}
  ]
}
