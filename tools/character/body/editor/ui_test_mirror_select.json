{
 "_doc": "Provar att spegelpunkten väljs med vid Shift-klick och tas bort vid Ctrl-klick, och att buren blir ensidig för två skilda delar. Öppnar yvonne_v8 och sparar inget.",
 "name": "body_editor_mirror_select",
 "url": "http://127.0.0.1:8772/",
 "size": [
  1600,
  1000
 ],
 "steps": [
  {
   "until": "window.editorState && document.getElementById('versions')?.options.length > 0",
   "timeout": 30000
  },
  {
   "wait": 800
  },
  {
   "eval": "(() => { const select = document.getElementById('versions'); select.value = 'yvonne_v8'; select.dispatchEvent(new Event('change')); document.getElementById('versionLoad').click(); return true; })()"
  },
  {
   "wait": 800
  },
  {
   "click": "Point",
   "in": "#tools button"
  },
  {
   "eval": "(window.p = window.editorState.pickPoint(0.08, 0.65, 0.09), window.q = window.editorState.pickPoint(0.09, 0.5, 0.09), [window.editorState.twinOf(window.p.v), window.editorState.twinOf(window.q.v)])"
  },
  {
   "drag": "(() => [[window.p.x, window.p.y], [window.p.x, window.p.y]])()"
  },
  {
   "wait": 50
  },
  {
   "expect": "window.editorState.selectedPoints === 1",
   "label": "a plain click takes one point"
  },
  {
   "drag": "(() => [[window.q.x, window.q.y], [window.q.x, window.q.y]])()",
   "modifiers": [
    "shift"
   ]
  },
  {
   "wait": 50
  },
  {
   "eval": "window.editorState.selectedPoints"
  },
  {
   "expect": "window.editorState.selectedPoints === 4",
   "label": "Shift-click takes both points and both twins"
  },
  {
   "expect": "window.editorState.selectedPointHas(window.editorState.twinOf(window.q.v)) && window.editorState.selectedPointHas(window.editorState.twinOf(window.p.v))",
   "label": "the twins are selected"
  },
  {
   "key": "b"
  },
  {
   "wait": 100
  },
  {
   "expect": "window.editorState.cageOpen && !window.editorState.cageSymmetric",
   "label": "two separate parts get a cage on one side"
  },
  {
   "eval": "(window.b = window.editorState.cagePointsBox, window.b)"
  },
  {
   "expect": "window.b.x[0] >= 0",
   "label": "the cage holds one side only"
  },
  {
   "drag": "(() => { const [x, y] = window.editorState.cageScreen(9); return [[x, y], [x + 40, y]]; })()"
  },
  {
   "wait": 150
  },
  {
   "expect": "window.editorState.cagePointsBox.x[1] > window.b.x[1] + 0.005 && window.editorState.cageTwinError < 5e-5",
   "label": "the twins follow the cage"
  },
  {
   "click": "Undo",
   "in": "button"
  },
  {
   "wait": 100
  },
  {
   "key": "Escape"
  },
  {
   "drag": "(() => [[window.q.x, window.q.y], [window.q.x, window.q.y]])()",
   "modifiers": [
    "ctrl"
   ]
  },
  {
   "wait": 50
  },
  {
   "expect": "window.editorState.selectedPoints === 2 && !window.editorState.selectedPointHas(window.q.v)",
   "label": "Ctrl-click removes the point and its twin"
  },
  {
   "eval": "(document.getElementById('mirror').click(), true)"
  },
  {
   "drag": "(() => [[window.q.x, window.q.y], [window.q.x, window.q.y]])()",
   "modifiers": [
    "shift"
   ]
  },
  {
   "wait": 50
  },
  {
   "expect": "window.editorState.selectedPoints === 3",
   "label": "without mirror Shift-click takes one"
  },
  {
   "eval": "(document.getElementById('mirror').click(), true)"
  }
 ]
}