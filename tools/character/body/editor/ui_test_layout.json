{
 "_doc": "Provar menyernas plats och den låsta vyn (se ui_test.json). Sparar inget.",
 "name": "body_editor_layout",
 "url": "http://127.0.0.1:8772/",
 "size": [
  1600,
  1000
 ],
 "steps": [
  {
   "until": "window.editorState && document.getElementById('versions')?.options.length > 0",
   "timeout": 30000
  },
  {
   "wait": 800
  },
  {
   "expect": "document.getElementById('views').closest('aside').classList.contains('left') && document.getElementById('slots').closest('aside').classList.contains('left') && document.getElementById('poses').closest('aside').classList.contains('left')",
   "label": "view controls are on the left"
  },
  {
   "expect": "document.getElementById('tools').closest('aside').classList.contains('right') && document.getElementById('save').closest('aside').classList.contains('right')",
   "label": "tools and save are on the right"
  },
  {
   "expect": "document.getElementById('lockView').checked === false",
   "label": "3D starts unlocked"
  },
  {
   "shot": "1_3d",
   "minLight": 25
  },
  {
   "drag": [
    [
     420,
     300
    ],
    [
     480,
     340
    ]
   ]
  },
  {
   "eval": "(() => { window.turned = window.editorState.cameraTurn; return window.turned; })()"
  },
  {
   "expect": "window.turned !== '0,0,0,1'",
   "label": "3D can be turned"
  },
  {
   "click": "Left",
   "in": "#views button"
  },
  {
   "wait": 300
  },
  {
   "expect": "document.getElementById('lockView').checked === true",
   "label": "a flat view locks itself"
  },
  {
   "eval": "(() => { window.turned = window.editorState.cameraTurn; return window.turned; })()"
  },
  {
   "drag": [
    [
     420,
     300
    ],
    [
     480,
     340
    ],
    [
     560,
     380
    ]
   ]
  },
  {
   "wait": 150
  },
  {
   "expect": "window.editorState.cameraTurn === window.turned",
   "label": "dragging does not turn a locked view"
  },
  {
   "drag": [
    [
     420,
     300
    ],
    [
     480,
     340
    ]
   ],
   "button": "right"
  },
  {
   "wait": 150
  },
  {
   "expect": "window.editorState.cameraTurn === window.turned",
   "label": "right drag does not turn it either"
  },
  {
   "shot": "2_left_locked",
   "minLight": 25
  },
  {
   "key": "l"
  },
  {
   "expect": "document.getElementById('lockView').checked === false",
   "label": "key L unlocks"
  },
  {
   "key": "l"
  },
  {
   "expect": "document.getElementById('lockView').checked === true",
   "label": "key L locks"
  },
  {
   "click": "Point",
   "in": "#tools button"
  },
  {
   "eval": "(() => { window.p = window.editorState.pickPoint(0.0, 1.05, 0.13); return window.p; })()"
  }
 ]
}