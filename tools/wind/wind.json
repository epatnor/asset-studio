{
  "_doc": "Fliken Vind i Väderkvarnen (docs/effektlabb.md): spakarna för vindfältet (shared/effects/wind.js), färdiga vindprofiler och gläntan som vinden provas i. Texten som visas är på engelska. Sparade profiler hamnar i assets/wind/<namn>.wind.json.",
  "params": [
    { "key": "strength", "label": "Strength", "min": 0, "max": 1.5, "step": 0.01, "default": 0.5, "help": "How hard it blows. The force grows with the square, like drag." },
    { "key": "dir", "label": "Direction (°)", "min": 0, "max": 360, "step": 1, "default": 30, "help": "Where the wind blows to, in degrees around the glade" },
    { "key": "gust", "label": "Gusts", "min": 0, "max": 1, "step": 0.01, "default": 0.5, "help": "How much of the force comes in gusts that roll across the ground" },
    { "key": "gustScale", "label": "Gust size (m)", "min": 4, "max": 60, "step": 1, "default": 18, "help": "Distance between the gust fronts" },
    { "key": "gustSpeed", "label": "Gust speed (m/s)", "min": 0, "max": 20, "step": 0.1, "default": 6, "help": "How fast the gusts travel with the wind" },
    { "key": "sway", "label": "Sway", "min": 0, "max": 1, "step": 0.01, "default": 0.35, "help": "Every part swings at its own rate around its lean: trunks slowly, twigs and stalks faster" },
    { "key": "flutter", "label": "Leaf flutter", "min": 0, "max": 1.5, "step": 0.01, "default": 0.5, "help": "Small, quick motion of leaves and cards, strongest at the tips" },
    { "key": "grassHeight", "label": "Grass height (×)", "min": 0.3, "max": 2.5, "step": 0.05, "default": 1, "help": "Taller or shorter grass in the glade", "view": true, "grass": "height" },
    { "key": "grassDensity", "label": "Grass density", "min": 0.1, "max": 1, "step": 0.05, "default": 1, "help": "Share of the blades that are drawn", "view": true, "grass": "density" },
    { "key": "grassStiffness", "label": "Grass stiffness", "min": 0.4, "max": 3, "step": 0.05, "default": 1, "help": "Stiffer blades bend less in the wind", "view": true, "grass": "stiffness" },
    { "key": "timeScale", "label": "Speed", "min": 0.05, "max": 1, "step": 0.01, "default": 1, "help": "Slow motion: lower to watch how the parts move", "view": true }
