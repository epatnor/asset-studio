{
  "_doc": "Väderfliken i Väderkvarnen (docs/effektlabb.md, E4): spakarna, färdiga väderlägen och platsens modeller. Ett väderläge styr hela atmosfären i shared/effects/weather.js (sol och måne, himmel med moln och stjärnor, höjddimma, regn och snö, åska, ljusstrålar), och samma väderlägen används av Vatten-fliken. Texten som visas är på engelska. Sparade väderlägen hamnar i assets/weather/<namn>.weather.json.",
  "groups": [
    {
      "id": "sun",
      "label": "Sun"
    },
    {
      "id": "clouds",
      "label": "Clouds & wind"
    },
    {
      "id": "precip",
      "label": "Rain & snow"
    },
    {
      "id": "storm",
      "label": "Thunder"
    },
    {
      "id": "fog",
      "label": "Fog & haze"
    },
    {
      "id": "night",
      "label": "Night"
    },
    {
      "id": "shafts",
      "label": "Light shafts"
    },
    {
      "id": "air",
      "label": "Air"
    }
  ],
  "params": [
    {
      "key": "hour",
      "group": "sun",
      "label": "Time of day",
      "min": 0,
      "max": 24,
      "step": 0.05,
      "default": 7.5,
      "help": "Where the sun stands over a Nordic summer day (up at 5, highest at 13, down at 21) and the night between, when the moon takes over"
    },
    {
      "key": "azimuth",
      "group": "sun",
      "label": "Sun direction",
      "min": 0,
      "max": 359,
      "step": 1,
      "default": 20,
      "help": "The compass direction of the sun (0 = behind the cottage, against the camera, which gives backlit shafts)"
    },
    {
      "key": "sun",
      "group": "sun",
      "label": "Sunlight",
      "min": 0,
      "max": 6,
      "step": 0.05,
      "default": 3,
      "help": "How strong the sunlight is"
    },
    {
      "key": "clouds",
      "group": "clouds",
      "label": "Cover",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 0.15,
      "help": "How much of the sky the clouds cover. Overcast dims the sun and greys the sky and the light"
    },
    {
      "key": "cloudSoft",
      "group": "clouds",
      "label": "Softness",
      "min": 0.03,
      "max": 0.6,
      "step": 0.01,
      "default": 0.25,
      "help": "Crisp, sharply edged clouds at low values, soft hazy veils at high values"
    },
    {
      "key": "cloudScale",
      "group": "clouds",
      "label": "Size",
      "min": 0.3,
      "max": 3,
      "step": 0.05,
      "default": 1,
      "help": "Large banks at low values, small fleecy clouds at high values"
    },
    {
      "key": "cloudDark",
      "group": "clouds",
      "label": "Darkness",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 0.3,
      "help": "How dark and heavy the clouds are underneath: white fair-weather clouds at 0, rain and storm clouds at 1"
    },
    {
      "key": "cloudSpeed",
      "group": "clouds",
      "label": "Drift",
      "min": 0,
      "max": 3,
      "step": 0.01,
      "default": 0.4,
      "help": "How fast the clouds drift with the wind"
    },
    {
      "key": "windDir",
      "group": "clouds",
      "label": "Wind direction",
      "min": 0,
      "max": 359,
      "step": 1,
      "default": 60,
      "help": "Which way the clouds drift and the rain and snow lean"
    },
    {
      "key": "wind",
      "group": "clouds",
      "label": "Wind",
      "min": 0,
      "max": 15,
      "step": 0.1,
      "default": 2,
      "help": "How hard the wind blows the rain and snow sideways (metres per second)"
    },
    {
      "key": "precip",
      "group": "precip",
      "label": "Falling",
      "type": "choice",
      "options": [
        {
          "id": "none",
          "label": "Nothing"
        },
        {
          "id": "rain",
          "label": "Rain"
        },
        {
          "id": "snow",
          "label": "Snow"
        }
      ],
      "default": "none",
      "help": "Rain falls as streaks along the wind, snow as drifting flakes. Rain also rings the water in the Water tab"
    },
    {
      "key": "amount",
      "group": "precip",
      "label": "Amount",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 0.5,
      "help": "From a few drops to a downpour (up to 16 000 drops or flakes around the camera)"
    },
    {
      "key": "lightning",
      "group": "storm",
      "label": "Lightning",
      "min": 0,
      "max": 30,
      "step": 0.5,
      "default": 0,
      "help": "Lightning strikes per minute, far off around the place, at uneven intervals"
    },
    {
      "key": "flash",
      "group": "storm",
      "label": "Flash",
      "min": 0,
      "max": 2,
      "step": 0.05,
      "default": 1,
      "help": "How brightly each strike lights up the clouds, the sky and the ground"
    },
    {
      "key": "fog",
      "group": "fog",
      "label": "Ground fog",
      "min": 0,
      "max": 0.3,
      "step": 0.002,
      "default": 0,
      "help": "Fog that lies thickest down by the ground and thins with height (height fog)"
    },
    {
      "key": "fogHeight",
      "group": "fog",
      "label": "Fog height",
      "min": 0.5,
      "max": 60,
      "step": 0.5,
      "default": 6,
      "help": "How thick the fog layer is in metres: a thin mist over the grass at low values, a valley full of fog at high"
    },
    {
      "key": "haze",
      "group": "fog",
      "label": "Haze",
      "min": 0,
      "max": 0.06,
      "step": 0.001,
      "default": 0.012,
      "help": "Distance haze in the sky's colour"
    },
    {
      "key": "moonPhase",
      "group": "night",
      "label": "Moon",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 1,
      "help": "How much of the moon is lit: new moon at 0, half at 0.5, full at 1. A fuller moon gives more light"
    },
    {
      "key": "moonlight",
      "group": "night",
      "label": "Moonlight",
      "min": 0,
      "max": 3,
      "step": 0.05,
      "default": 1,
      "help": "How strongly the moon lights the night (and casts shadows when it is brighter than the sun)"
    },
    {
      "key": "stars",
      "group": "night",
      "label": "Stars",
      "min": 0,
      "max": 2,
      "step": 0.05,
      "default": 1,
      "help": "How bright the stars are when it is dark and clear"
    },
    {
      "key": "shafts",
      "group": "shafts",
      "label": "Strength",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 0.45,
      "help": "How strongly the shafts colour the air (the brightest they can get)"
    },
    {
      "key": "density",
      "group": "shafts",
      "label": "Density",
      "min": 0,
      "max": 3,
      "step": 0.01,
      "default": 0.55,
      "help": "How thick the air is: thin air gives faint shafts, thick air shafts that fill the clearing"
    },
    {
      "key": "falloff",
      "group": "shafts",
      "label": "Falloff",
      "min": 0,
      "max": 6,
      "step": 0.05,
      "default": 2,
      "help": "How fast the shafts fade far from the sun's source"
    },
    {
      "key": "backlight",
      "group": "shafts",
      "label": "Backlight",
      "min": 0,
      "max": 0.9,
      "step": 0.01,
      "default": 0.6,
      "help": "How much brighter the shafts are when you look toward the sun. High: they blaze in backlight and almost vanish from the side, like real sunbeams. 0: the same from every direction"
    },
    {
      "key": "followSun",
      "group": "shafts",
      "label": "Shaft colour",
      "type": "bool",
      "default": true,
      "sub": "Follow the time of day",
      "help": "Warm in the morning and evening, pale at noon. Turn off to choose the colour yourself"
    },
    {
      "key": "shaftColor",
      "group": "shafts",
      "label": "Colour",
      "type": "color",
      "default": "#ffd9a0",
      "help": "The shafts' colour when they do not follow the time of day"
    },
    {
      "key": "quality",
      "group": "shafts",
      "label": "Quality",
      "type": "choice",
      "options": [
        {
          "id": "low",
          "label": "Low"
        },
        {
          "id": "medium",
          "label": "Medium"
        },
        {
          "id": "high",
          "label": "High"
        }
      ],
      "default": "medium",
      "help": "Low: quarter resolution and 30 steps. Medium: half resolution and 60 steps. High: full resolution and 90 steps"
    },
    {
      "key": "glow",
      "group": "air",
      "label": "Sun glow",
      "min": 0,
      "max": 3,
      "step": 0.05,
      "default": 1,
      "help": "The sun disc and the glare around it"
    },
    {
      "key": "dust",
      "group": "air",
      "label": "Dust in the light",
      "min": 0,
      "max": 800,
      "step": 1,
      "default": 180,
      "help": "Specks of dust drifting in the air, glinting in the light"
    },
    {
      "key": "exposure",
      "group": "air",
      "label": "Exposure",
      "min": 0.4,
      "max": 2,
      "step": 0.01,
      "default": 1.1,
      "help": "Overall brightness"
    }
  ],
