{
  "_doc": "UI-test av Kartrummets steg Populate (tools/studio/ui_test.py): Green isle, lagren, naturen i nivåer (stand-ins på avstånd, fulla modeller nära, med fps och trianglar), Detail range, ett lager av med Density 0, New seed, Spara med inställningarna och ladda tillbaka. Sparar världen ui_test_populate i assets/terrain/; ta bort den efteråt.",
  "name": "populate",
  "url": "/studio/#kartrummet-populate",
  "size": [1600, 1000],
  "steps": [
    {"until": "window.__studio?.terrain?.popResult && window.__studio.terrain.natureStats() && document.querySelector('#tfoot .msg')?.textContent.includes('orbit')", "timeout": 180000},
    {"expect": "__studio.terrain.step === 'populate' && document.querySelector('#kinds button.on')?.textContent === 'Populate'", "label": "the Populate step opens with its tab highlighted"},
    {"expect": "document.querySelectorAll('#tdrawer .wprof[data-layer]').length === 12", "label": "the drawer lists the twelve layers"},
    {"expect": "__studio.terrain.popResult.total > 10000 && __studio.terrain.popResult.layers.find((l) => l.id === 'broadleaf').count > 300", "label": "the island fills with nature by the rules"},
    {"wait": 3000},
    {"eval": "({ stats: __studio.terrain.natureStats(), fps: __studio.terrain.fps, ms: __studio.terrain.popResult.ms })"},
    {"expect": "__studio.terrain.natureStats().proxy > 300", "label": "far away the trees are light stand-ins"},
    {"expect": "/Nature/.test(document.querySelector('#tfoot').textContent) && /far \\d/.test(document.querySelector('#tfoot').textContent)", "label": "the footer shows the nature and the levels"},
    {"shot": "1_overview", "minLight": 30},
    {"eval": "(() => { const t = __studio.terrain, d = t.popResult.layers.find((l) => l.id === 'broadleaf').data, x = d[0], y = d[1], z = d[2]; t.controls.target.set(x, y + 4, z); t.camera.position.set(x + 30, y + 22, z + 45); t.controls.update(); return [x, y, z]; })()"},
    {"wait": 4000},
    {"eval": "({ stats: __studio.terrain.natureStats(), fps: __studio.terrain.fps })"},
    {"expect": "__studio.terrain.natureStats().near > 5 && __studio.terrain.natureStats().mid > 5", "label": "near the camera the full models are drawn, then LOD1"},
    {"shot": "2_close", "minLight": 30},
    {"slider": "Detail range", "value": 2, "in": "#tside"},
    {"wait": 1500},
    {"expect": "__studio.terrain.natureStats().near > 5", "label": "Detail range moves the levels out"},
    {"eval": "({ stats: __studio.terrain.natureStats(), fps: __studio.terrain.fps })"},
    {"slider": "Detail range", "value": 1, "in": "#tside"},
    {"click": "Bushes", "in": "#tdrawer .wprof"},
    {"expect": "document.querySelector('#tside').textContent.includes('Bushes:')", "label": "the Layer card shows the picked layer"},
    {"slider": "Density", "value": 0, "in": "#tside"},
    {"until": "__studio.terrain.popResult.layers.find((l) => l.id === 'bushes').count === 0 && document.querySelector('#tfoot .msg')?.textContent.includes('orbit')", "timeout": 60000},
    {"eval": "window.__p0 = Array.from(__studio.terrain.popResult.layers[0].data.slice(0, 3))"},
    {"click": "New seed", "in": "#tdrawer button"},
    {"until": "__studio.terrain.popResult.layers[0].data[0] !== window.__p0[0] && document.querySelector('#tfoot .msg')?.textContent.includes('orbit')", "timeout": 60000},
    {"expect": "__studio.terrain.popResult.layers[0].count > 300", "label": "a new seed gives another layout of the same rules"},
    {"shot": "3_new_seed", "minLight": 30},
    {"prompt": "ui_test_populate"},
    {"click": "Save world", "in": "#tside button"},
    {"wait": 1500},
    {"expect": "fetch('/api/terrain').then((r) => r.json()).then((d) => { const x = d.saved.find((s) => s.name === 'ui_test_populate'); return x?.populate?.layers?.bushes?.density === 0 && x.populate.seed > 0; })", "label": "Save stores the nature settings"},
    {"click": "World", "in": "#kinds button"},
    {"wait": 300},
    {"click": "Green isle", "in": "#tdrawer .wprof"},
    {"until": "document.querySelector('#tfoot .msg')?.textContent.includes('orbit')", "timeout": 60000},
    {"click": "ui_test_populate", "in": "#tdrawer .wprof"},
    {"until": "document.querySelector('#tfoot .msg')?.textContent.includes('orbit')", "timeout": 60000},
    {"click": "Populate", "in": "#kinds button"},
    {"until": "__studio.terrain.popResult && document.querySelector('#tfoot .msg')?.textContent.includes('orbit')", "timeout": 60000},
    {"wait": 1500},
    {"expect": "__studio.terrain.popResult.layers.find((l) => l.id === 'bushes').count === 0 && __studio.terrain.vals.populate.layers.bushes.density === 0", "label": "loading the world brings the nature settings back"}
  ]
}
