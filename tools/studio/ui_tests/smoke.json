{
  "_doc": "Röktest av hela studion (tools/studio/ui_test.py): varje avdelning och flik öppnas via headern, får ladda och fotograferas; ingen vy får vara svart och inga JavaScript-fel får uppstå.",
  "name": "smoke",
  "url": "/studio/#smedjan",
  "size": [1600, 1000],
  "steps": [
    {"until": "document.querySelector('#depts button.on')?.dataset.dept === 'forge'", "timeout": 60000},
    {"wait": 6000},
    {"shot": "1_forge", "minLight": 30},
    {"click": "Windmill", "in": "#depts button"},
    {"until": "document.body.classList.contains('wind-mode') || document.documentElement.dataset.dept === 'windmill'", "timeout": 60000},
    {"wait": 8000},
    {"shot": "2_wind", "minLight": 30},
    {"click": "Water", "in": "#kinds button"},
    {"until": "document.body.classList.contains('water-mode') && document.querySelector('#wafoot .msg')?.textContent.includes('ripples')", "timeout": 90000},
    {"wait": 3000},
    {"shot": "3_water_lake", "minLight": 30},
    {"click": "Stream", "in": ".stagebar button"},
    {"until": "document.querySelector('#wafoot .msg')?.textContent.includes('ripples')", "timeout": 90000},
    {"wait": 4000},
    {"shot": "4_water_stream", "minLight": 30},
    {"click": "Beach", "in": ".stagebar button"},
    {"until": "document.querySelector('#wafoot .msg')?.textContent.includes('ripples')", "timeout": 90000},
    {"wait": 4000},
    {"shot": "5_water_beach", "minLight": 30},
    {"click": "Open water", "in": ".stagebar button"},
    {"until": "document.querySelector('#wafoot .msg')?.textContent.includes('ripples')", "timeout": 90000},
    {"wait": 3000},
    {"shot": "6_water_open", "minLight": 30},
    {"click": "Weather", "in": "#kinds button"},
    {"until": "document.body.classList.contains('weather-mode')", "timeout": 60000},
    {"wait": 8000},
    {"shot": "7_weather", "minLight": 30},
    {"click": "Atelier", "in": "#depts button"},
    {"until": "document.documentElement.dataset.dept === 'atelier'", "timeout": 60000},
    {"wait": 6000},
    {"shot": "8_atelier", "minLight": 30},
    {"click": "Cauldron", "in": "#depts button"},
    {"until": "document.documentElement.dataset.dept === 'cauldron'", "timeout": 60000},
    {"wait": 8000},
    {"shot": "9_cauldron", "minLight": 30},
    {"click": "Map Room", "in": "#depts button"},
    {"until": "document.body.classList.contains('terrain-mode') && document.querySelector('#tfoot .msg')?.textContent.includes('Drag')", "timeout": 120000},
    {"wait": 2000},
    {"shot": "10_maproom", "minLight": 30},
    {"click": "Vault", "in": "#depts button"},
    {"until": "document.documentElement.dataset.dept === 'vault'", "timeout": 60000},
    {"wait": 6000},
    {"shot": "11_vault", "minLight": 30}
  ]
}
