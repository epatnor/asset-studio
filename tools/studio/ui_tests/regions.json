{
  "_doc": "UI-test av Kartrummets steg Regions (tools/studio/ui_test.py): Mountain isle med tre regioner, namnen på kartan, lägg till en region, byt tema och namn, flytta en mittpunkt, måla en gräns (ett riktigt musdrag), Spara, ta bort och ladda tillbaka. Sparar världen ui_test_regions i assets/terrain/; ta bort den efteråt.",
  "name": "regions",
  "url": "/studio/#kartrummet",
  "size": [1600, 1000],
  "steps": [
    {"until": "window.__studio?.terrain?.regionInfo && document.querySelector('#tfoot .msg')?.textContent.includes('orbit')", "timeout": 120000},
    {"click": "Mountain isle", "in": "#tdrawer .wprof"},
    {"until": "__studio.terrain.regionInfo?.coverage?.length === 3 && document.querySelector('#tfoot .msg')?.textContent.includes('orbit')", "timeout": 60000},
    {"click": "Regions", "in": "#kinds button"},
    {"wait": 500},
    {"expect": "__studio.terrain.step === 'regions' && __studio.terrain.vals.view === 'regions'", "label": "the Regions step opens with the region view"},
    {"expect": "document.querySelector('#kinds button.on')?.textContent === 'Regions'", "label": "the Regions tab is highlighted"},
    {"expect": "document.querySelectorAll('#tdrawer .wprof[data-pick]').length === 4", "label": "the drawer has the three regions and Erase"},
    {"expect": "[...document.querySelectorAll('.rlabel')].filter((d) => !d.hidden && d.offsetParent !== null).length === 3", "label": "the three names stand on the map"},
    {"expect": "__studio.terrain.regionInfo.coverage.every((c) => c > 10)", "label": "every region has more than 10 % of the land"},
    {"expect": "/Greenhollow \\d/.test(document.querySelector('#tfoot').textContent)", "label": "the footer shows the region shares"},
    {"shot": "1_region_view", "minLight": 30},
    {"eval": "__studio.terrain.stats().coverage"},
    {"click": "Add region", "in": "#tdrawer button"},
    {"until": "__studio.terrain.regionInfo.coverage.length === 4 && document.querySelector('#tfoot .msg')?.textContent.includes('orbit')", "timeout": 30000},
    {"expect": "__studio.terrain.regionSel === 3", "label": "the new region is selected"},
    {"select": "Theme", "value": "gloom", "in": "#tside"},
    {"until": "document.querySelector('#tfoot .msg')?.textContent.includes('orbit')", "timeout": 30000},
    {"wait": 500},
    {"expect": "__studio.terrain.vals.regions[3].theme === 'gloom' && document.querySelector('#tdrawer').textContent.includes('Gloomwood')", "label": "the theme changes in the Region card"},
    {"eval": "(() => { const i = document.querySelector('#tside .rname'); i.value = 'Duskhollow'; i.dispatchEvent(new Event('change')); return __studio.terrain.vals.regions[3].name; })()"},
    {"expect": "[...document.querySelectorAll('.rlabel')].some((d) => d.textContent.includes('Duskhollow'))", "label": "a new name shows on the map"},
    {"eval": "window.__c0 = JSON.stringify(__studio.terrain.regionInfo.centers[3])"},
    {"click": "Move centre", "in": "#tdrawer button"},
    {"drag": [[760, 560], [760, 560]]},
    {"until": "document.querySelector('#tfoot .msg')?.textContent.includes('orbit')", "timeout": 30000},
    {"wait": 500},
    {"expect": "Array.isArray(__studio.terrain.vals.regions[3].at) && JSON.stringify(__studio.terrain.regionInfo.centers[3]) !== window.__c0", "label": "Move centre puts the centre where you click"},
    {"eval": "window.__g0 = __studio.terrain.regionInfo.coverage[0]"},
    {"click": "Greenhollow", "in": "#tdrawer .wprof"},
    {"expect": "__studio.terrain.controls.mouseButtons.LEFT === -1", "label": "with a region picked the left button paints"},
    {"slider": "Brush size", "value": 120, "in": "#tside"},
    {"slider": "Strength", "value": 1, "in": "#tside"},
    {"drag": [[600, 450], [750, 430], [900, 470], [1050, 450]]},
    {"until": "document.querySelector('#tfoot .msg')?.textContent.includes('Painting Greenhollow')", "timeout": 30000},
    {"wait": 1500},
    {"expect": "__studio.terrain.regionInfo.coverage[0] > window.__g0 + 0.5", "label": "a brush stroke paints a region"},
    {"shot": "2_painted", "minLight": 30},
    {"click": "Shaded", "in": ".stagebar button"},
    {"wait": 1500},
    {"shot": "3_shaded", "minLight": 30},
    {"prompt": "ui_test_regions"},
    {"click": "Save world", "in": "#tside button"},
    {"wait": 1500},
    {"expect": "fetch('/api/terrain').then((r) => r.json()).then((d) => { const x = d.saved.find((s) => s.name === 'ui_test_regions'); return x?.regions?.length === 4 && x.regions[3].name === 'Duskhollow' && x.regions[3].theme === 'gloom' && Array.isArray(x.regions[3].at) && x.settings.height === 190 && (x.layers?.regionPaint?.length ?? 0) > 100; })", "label": "Save stores the regions and the painted borders"},
    {"click": "Remove", "in": "#tdrawer button"},
    {"until": "__studio.terrain.regionInfo.coverage.length === 3", "timeout": 30000},
    {"expect": "__studio.terrain.vals.regions.length === 3", "label": "Remove takes the region away"},
    {"click": "World", "in": "#kinds button"},
    {"wait": 300},
    {"click": "ui_test_regions", "in": "#tdrawer .wprof"},
    {"until": "__studio.terrain.regionInfo?.coverage?.length === 4 && document.querySelector('#tfoot .msg')?.textContent.includes('orbit')", "timeout": 60000},
    {"expect": "__studio.terrain.vals.regions[3].name === 'Duskhollow' && __studio.terrain.regionPaint.some((v) => v)", "label": "loading the world brings the regions and the painting back"},
    {"click": "Regions", "in": "#kinds button"},
    {"wait": 1000},
    {"shot": "4_reloaded", "minLight": 30}
  ]
}
