{
  "_doc": "UI-test av Kartrummets steg Sculpt (tools/studio/ui_test.py): Green isle, penseln Raise (ett riktigt musdrag), Undo, mönstret Crater, ] för storleken, egna inställningar per pensel, Ctrl som vänder, Terrace, Erode, landformerna Mountain och Island med ett klick, en å som klickas fram och grävs, en vik via receptet, Spara med skulpteringen och vattnet, Clear sculpting och ladda tillbaka. Sparar världen ui_test_sculpt i assets/terrain/; ta bort den efteråt.",
  "name": "sculpt",
  "url": "/studio/#kartrummet-sculpt",
  "size": [1600, 1000],
  "steps": [
    {"until": "window.__studio?.terrain?.field && document.querySelector('#tfoot .msg')?.textContent.includes('orbit')", "timeout": 120000},
    {"expect": "__studio.terrain.step === 'sculpt' && __studio.terrain.vals.view === 'shaded'", "label": "the Sculpt step opens in the shaded view"},
    {"expect": "document.querySelector('#kinds button.on')?.textContent === 'Sculpt'", "label": "the Sculpt tab is highlighted"},
    {"expect": "document.querySelectorAll('#tdrawer .wprof[data-tool]').length === 16", "label": "the drawer has eight brushes, five landforms and three kinds of water"},
    {"click": "Raise", "in": "#tdrawer .wprof"},
    {"expect": "__studio.terrain.sculptTool === 'raise' && __studio.terrain.controls.mouseButtons.LEFT === -1", "label": "with a brush the left button sculpts"},
    {"slider": "Size", "value": 40, "in": "#tside"},
    {"slider": "Strength", "value": 1, "in": "#tside"},
    {"eval": "window.__top0 = __studio.terrain.field.heights.reduce((a, b) => Math.max(a, b), -1e9)"},
    {"drag": [[560, 520], [600, 515], [640, 520], [600, 525], [560, 520]]},
    {"until": "document.querySelector('#tfoot .msg')?.textContent.includes('drag on the land')", "timeout": 60000},
    {"expect": "__studio.terrain.delta && __studio.terrain.delta.reduce((a, b) => a + b, 0) > 50", "label": "a Raise stroke lifts the land"},
    {"expect": "/shaped/.test(document.querySelector('#tfoot').textContent)", "label": "the footer says the world is shaped"},
    {"shot": "1_raised", "minLight": 30},
    {"click": "Undo", "in": "#tdrawer button"},
    {"until": "document.querySelector('#tfoot .msg')?.textContent.includes('drag on the land')", "timeout": 60000},
    {"expect": "__studio.terrain.delta === null", "label": "Undo takes the stroke back"},
    {"drag": [[560, 520], [600, 515], [640, 520]]},
    {"until": "document.querySelector('#tfoot .msg')?.textContent.includes('drag on the land')", "timeout": 60000},
    {"expect": "__ui.els('#tside label').some((l) => l.textContent === 'Hardness') && __ui.els('#tside label').some((l) => l.textContent === 'Spacing')", "label": "the Brush card has hardness (falloff) and spacing"},
    {"expect": "document.querySelector('#tdrawer').textContent.includes('Pattern for Raise') && document.querySelectorAll('#tdrawer .wprof[data-stamp]').length === 10", "label": "Raise offers ten patterns"},
    {"click": "Crater", "in": "#tdrawer .wprof"},
    {"expect": "__studio.terrain.sculptSettings().stamp === 'crater' && __ui.els('#tside label').some((l) => l.textContent === 'Rotation')", "label": "picking a pattern shows rotation and scatter"},
    {"drag": "[__studio.terrain.screenOf(-150, 120), __studio.terrain.screenOf(-150, 120)]"},
    {"until": "document.querySelector('#tfoot .msg')?.textContent.includes('drag on the land')", "timeout": 60000},
    {"expect": "__studio.terrain.delta.some((v) => v < -0.2) && __studio.terrain.delta.some((v) => v > 0.2)", "label": "a crater sinks its middle and raises its rim"},
    {"eval": "window.__s0 = __studio.terrain.sculptSettings().size"},
    {"key": "]"},
    {"expect": "__studio.terrain.sculptSettings().size > window.__s0", "label": "] makes the brush bigger"},
    {"click": "Round", "in": "#tdrawer .wprof"},
    {"click": "Smooth", "in": "#tdrawer .wprof"},
    {"expect": "__studio.terrain.sculptSettings().size === 25", "label": "each brush keeps its own settings"},
    {"click": "Raise", "in": "#tdrawer .wprof"},
    {"eval": "window.__d0 = __studio.terrain.delta.reduce((a, b) => a + b, 0)"},
    {"drag": "[__studio.terrain.screenOf(-60, 160), __studio.terrain.screenOf(-30, 160)]", "modifiers": ["ctrl"]},
    {"until": "document.querySelector('#tfoot .msg')?.textContent.includes('drag on the land')", "timeout": 60000},
    {"expect": "__studio.terrain.delta.reduce((a, b) => a + b, 0) < window.__d0 - 5", "label": "Ctrl turns Raise into Lower"},
    {"click": "Terrace", "in": "#tdrawer .wprof"},
    {"eval": "window.__d0 = __studio.terrain.delta.reduce((a, b) => a + Math.abs(b), 0)"},
    {"drag": "[__studio.terrain.screenOf(60, -120), __studio.terrain.screenOf(90, -110), __studio.terrain.screenOf(120, -120)]"},
    {"until": "document.querySelector('#tfoot .msg')?.textContent.includes('drag on the land')", "timeout": 60000},
    {"expect": "__studio.terrain.delta.reduce((a, b) => a + Math.abs(b), 0) > window.__d0 + 5", "label": "Terrace steps the land"},
    {"click": "Erode", "in": "#tdrawer .wprof"},
    {"eval": "window.__d0 = __studio.terrain.delta.reduce((a, b) => a + Math.abs(b), 0)"},
    {"drag": "[__studio.terrain.screenOf(150, 60), __studio.terrain.screenOf(170, 90), __studio.terrain.screenOf(190, 120)]"},
    {"until": "document.querySelector('#tfoot .msg')?.textContent.includes('drag on the land')", "timeout": 60000},
    {"expect": "__studio.terrain.delta.reduce((a, b) => a + Math.abs(b), 0) > window.__d0 + 1", "label": "Erode moves soil"},
    {"click": "Mountain", "in": "#tdrawer .wprof"},
    {"expect": "__ui.els('#tside label').some((l) => l.textContent === 'New each click')", "label": "a landform has its own size, height and variation"},
    {"eval": "window.__top0 = __studio.terrain.field.heights.reduce((a, b) => Math.max(a, b), -1e9)"},
    {"drag": "[__studio.terrain.screenOf(-250, -180), __studio.terrain.screenOf(-250, -180)]"},
    {"until": "document.querySelector('#tfoot .msg')?.textContent.includes('click once')", "timeout": 60000},
    {"expect": "__studio.terrain.field.heights.reduce((a, b) => Math.max(a, b), -1e9) > window.__top0 + 50", "label": "one click places a whole mountain"},
    {"click": "Island", "in": "#tdrawer .wprof"},
    {"eval": "(() => { const f = __studio.terrain.field, h = 512, i = Math.round((0 + h) / f.cell), j = Math.round((-440 + h) / f.cell); return f.heights[j * f.n + i]; })()"},
    {"drag": "[__studio.terrain.screenOf(0, -440), __studio.terrain.screenOf(0, -440)]"},
    {"until": "document.querySelector('#tfoot .msg')?.textContent.includes('click once')", "timeout": 60000},
    {"expect": "(() => { const f = __studio.terrain.field, h = 512, i = Math.round((0 + h) / f.cell), j = Math.round((-440 + h) / f.cell); return f.heights[j * f.n + i] > 3; })()", "label": "an island rises out of the sea"},
    {"shot": "1b_landforms", "minLight": 30},
    {"click": "Height", "in": ".stagebar button"},
    {"wait": 1000},
    {"shot": "1c_landforms_height", "minLight": 30},
    {"click": "Shaded", "in": ".stagebar button"},
    {"click": "River", "in": "#tdrawer .wprof"},
    {"drag": [[640, 380], [640, 380]]},
    {"drag": [[760, 470], [760, 470]]},
    {"drag": [[880, 560], [880, 560]]},
    {"drag": [[1000, 680], [1000, 680]]},
    {"expect": "/4 so far/.test(document.querySelector('#tfoot .msg').textContent)", "label": "the river line has four points"},
    {"click": "Finish line", "in": "#tdrawer button"},
    {"until": "__studio.terrain.channelInfo.length === 1 && document.querySelector('#tfoot .msg')?.textContent.includes('click points')", "timeout": 60000},
    {"expect": "(() => { const s = __studio.terrain.channelInfo[0].smp; return s.length > 20 && s.every((p, i) => !i || p.level <= s[i - 1].level + 1e-6); })()", "label": "the river is dug and its surface only runs downhill"},
    {"expect": "(() => { const f = __studio.terrain.field, s = __studio.terrain.channelInfo[0].smp, p = s[Math.floor(s.length / 3)], h = __studio.terrain.vals.worldSize / 2, i = Math.round((p.x + h) / f.cell), j = Math.round((p.z + h) / f.cell); return f.heights[j * f.n + i] < p.level; })()", "label": "the river bed lies under the water"},
    {"expect": "__studio.terrain.scene.children.some((m) => m.isMesh && m.visible && m.geometry?.getAttribute('flow') && m.geometry.getAttribute('position').count > 20 && m.geometry.getAttribute('position').count < 100000)", "label": "the river has a water surface"},
    {"shot": "2_river", "minLight": 30},
    {"eval": "(async () => { __studio.terrain.vals.channels.push({ kind: 'bay', points: [[0, 0.47], [0.02, 0.3], [0, 0.22]] }); await __studio.terrain.regenerate('edit'); return __studio.terrain.channelInfo.length; })()"},
    {"expect": "(() => { const f = __studio.terrain.field, h = __studio.terrain.vals.worldSize / 2, i = Math.round((0.01 * 1024 + h) / f.cell), j = Math.round((0.3 * 1024 + h) / f.cell); return f.heights[j * f.n + i] < -1; })()", "label": "the bay is dug under the sea"},
    {"click": "Height", "in": ".stagebar button"},
    {"wait": 1000},
    {"shot": "3_height", "minLight": 30},
    {"click": "Shaded", "in": ".stagebar button"},
    {"prompt": "ui_test_sculpt"},
    {"click": "Save world", "in": "#tside button"},
    {"wait": 1500},
    {"expect": "fetch('/api/terrain').then((r) => r.json()).then((d) => { const x = d.saved.find((s) => s.name === 'ui_test_sculpt'); return x?.channels?.length === 2 && x.channels[0].kind === 'river' && (x.layers?.sculpt?.length ?? 0) > 50; })", "label": "Save stores the sculpting and the dug water"},
    {"prompt": "yes"},
    {"click": "Clear sculpting", "in": "#tdrawer button"},
    {"until": "__studio.terrain.channelInfo.length === 0 && document.querySelector('#tfoot .msg')?.textContent.includes('click points')", "timeout": 60000},
    {"expect": "__studio.terrain.delta === null && __studio.terrain.vals.channels.length === 0", "label": "Clear sculpting goes back to the generated world"},
    {"click": "World", "in": "#kinds button"},
    {"wait": 300},
    {"click": "ui_test_sculpt", "in": "#tdrawer .wprof"},
    {"until": "__studio.terrain.channelInfo?.length === 2 && document.querySelector('#tfoot .msg')?.textContent.includes('orbit')", "timeout": 60000},
    {"expect": "__studio.terrain.delta && __studio.terrain.delta.some((v) => v > 0.1)", "label": "loading the world brings the sculpting back"},
    {"click": "Sculpt", "in": "#kinds button"},
    {"wait": 1500},
    {"shot": "4_reloaded", "minLight": 30}
  ]
}
