      { "key": "mortar", "label": "Fogbredd", "type": "number", "min": 0, "max": 0.3, "step": 0.01, "default": 0.07 },
      { "key": "jitter", "label": "Ojämnhet", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.35 },
      { "key": "chip", "label": "Avslagna hörn", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.3 },
      { "key": "tint", "label": "Färgvariation", "type": "number", "min": 0, "max": 0.5, "step": 0.01, "default": 0.12 },
      { "key": "seed", "label": "Frö", "type": "seed", "default": 1 },
      { "key": "light", "label": "Stenens färg", "type": "color", "default": "#B5563A" },
      { "key": "dark", "label": "Fogens färg", "type": "color", "default": "#D9CBB0" }
