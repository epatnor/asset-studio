{
  "_doc": "Texturverkstadens spakar (docs/texture-workshop.md). sources: källor (en per recept), steps: bildbehandlingssteg (en stapel), material: materiallabbets egenskaper (punktade nycklar i recipe.material; client: true = räknas i 3D-vyn utan att texturen görs om), blend: spakar per blandningslager (recipe.blend.layers, bara i 3D-vyn och klientens shader), layer_presets: färdiga lager, profiles: målprofiler (vem som använder texturen). Spaktyper: number, int, select, color, seed, texture, bool, input (en ingrediens), text. adv: true lägger spaken under Avancerat; when: {nyckel: värde eller [värden]} visar den bara när villkoret gäller. Färger anges som #RRGGBB i sRGB. presets: färdiga material som tumnaglar i verkstadens bibliotek (group, label, profile, recipe med source, steps, inputs och material).",
  "sources": {
    "noise": {
      "label": "Brus",
      "params": [
        {"key": "kind", "label": "Sort", "type": "select", "options": {"Mjukt (fBm)": "fbm", "Celler (Worley)": "worley", "Fläckar": "blobs"}, "default": "fbm"},
        {"key": "scale", "label": "Skala", "type": "number", "min": 1, "max": 32, "step": 1, "default": 6, "help": "Antal stora former över texturen"},
        {"key": "octaves", "label": "Oktaver", "type": "int", "min": 1, "max": 6, "default": 4, "adv": true},
        {"key": "sharpness", "label": "Skärpa", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.3, "adv": true},
        {"key": "seed", "label": "Frö", "type": "seed", "default": 1},
        {"key": "dark", "label": "Mörk färg", "type": "color", "default": "#3E5A2B"},
        {"key": "light", "label": "Ljus färg", "type": "color", "default": "#8FB65A"}
      ]
    },
    "bark": {
      "label": "Bark",
      "params": [
        {"key": "ridges", "label": "Åsar", "type": "int", "min": 2, "max": 20, "default": 7},
        {"key": "depth", "label": "Fårornas djup", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.6},
        {"key": "width", "label": "Fårornas bredd", "type": "number", "min": 0.05, "max": 0.6, "step": 0.01, "default": 0.22, "adv": true},
        {"key": "wiggle", "label": "Slingrighet", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.45, "adv": true},
        {"key": "plates", "label": "Plattor", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.35, "help": "Tvärgående sprickor som delar åsarna i plattor", "adv": true},
        {"key": "detail", "label": "Fin detalj", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.25, "adv": true},
        {"key": "seed", "label": "Frö", "type": "seed", "default": 1},
        {"key": "dark", "label": "Fårornas färg", "type": "color", "default": "#3B2618"},
        {"key": "light", "label": "Åsarnas färg", "type": "color", "default": "#8A5B3A"}
      ]
    },
    "stone": {
      "label": "Sten och kullersten",
      "params": [
        {"key": "cells", "label": "Stenar", "type": "int", "min": 4, "max": 120, "default": 28},
        {"key": "gap", "label": "Fogbredd", "type": "number", "min": 0, "max": 0.3, "step": 0.01, "default": 0.08},
        {"key": "variation", "label": "Variation i storlek", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.5, "adv": true},
        {"key": "round", "label": "Rundning", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.6, "adv": true},
        {"key": "tint", "label": "Färgvariation", "type": "number", "min": 0, "max": 0.5, "step": 0.01, "default": 0.15, "adv": true},
        {"key": "seed", "label": "Frö", "type": "seed", "default": 1},
        {"key": "light", "label": "Stenens färg", "type": "color", "default": "#A9A39A"},
        {"key": "dark", "label": "Fogens färg", "type": "color", "default": "#4C4636"}
      ]
    },
    "bricks": {
      "label": "Tegel och murverk",
      "params": [
        {"key": "rows", "label": "Rader", "type": "int", "min": 2, "max": 24, "default": 8},
        {"key": "cols", "label": "Stenar per rad", "type": "int", "min": 1, "max": 12, "default": 4},
        {"key": "offset", "label": "Förband (förskjutning)", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.5, "adv": true},
        {"key": "mortar", "label": "Fogbredd", "type": "number", "min": 0, "max": 0.3, "step": 0.01, "default": 0.07, "adv": true},
        {"key": "jitter", "label": "Ojämnhet", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.35, "adv": true},
        {"key": "chip", "label": "Avslagna hörn", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.3, "adv": true},
        {"key": "tint", "label": "Färgvariation", "type": "number", "min": 0, "max": 0.5, "step": 0.01, "default": 0.12, "adv": true},
        {"key": "seed", "label": "Frö", "type": "seed", "default": 1},
        {"key": "light", "label": "Stenens färg", "type": "color", "default": "#B5563A"},
        {"key": "dark", "label": "Fogens färg", "type": "color", "default": "#D9CBB0"}
      ]
    },
    "planks": {
      "label": "Plankor och trä",
      "params": [
        {"key": "planks", "label": "Plankor", "type": "int", "min": 1, "max": 16, "default": 5},
        {"key": "length", "label": "Skarvar per planka", "type": "int", "min": 0, "max": 4, "default": 1, "adv": true},
        {"key": "grain", "label": "Ådring", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.5},
        {"key": "knots", "label": "Kvistar", "type": "int", "min": 0, "max": 12, "default": 3, "adv": true},
        {"key": "gap", "label": "Springor", "type": "number", "min": 0, "max": 0.2, "step": 0.005, "default": 0.025, "adv": true},
        {"key": "tint", "label": "Färgvariation", "type": "number", "min": 0, "max": 0.5, "step": 0.01, "default": 0.12, "adv": true},
        {"key": "seed", "label": "Frö", "type": "seed", "default": 1},
        {"key": "dark", "label": "Mörkt trä", "type": "color", "default": "#5A3A22"},
        {"key": "light", "label": "Ljust trä", "type": "color", "default": "#A87A4E"}
      ]
    },
    "shingles": {
      "label": "Takpannor och spån",
      "params": [
        {"key": "rows", "label": "Rader", "type": "int", "min": 2, "max": 20, "default": 8},
        {"key": "cols", "label": "Pannor per rad", "type": "int", "min": 1, "max": 16, "default": 6},
        {"key": "shape", "label": "Form", "type": "select", "options": {"Runda (fjäll)": "round", "Raka (spån)": "square", "Spetsiga": "pointed"}, "default": "round"},
        {"key": "overlap", "label": "Skugga under raden", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.5, "adv": true},
        {"key": "gap", "label": "Springor", "type": "number", "min": 0, "max": 0.2, "step": 0.005, "default": 0.03, "adv": true},
        {"key": "jitter", "label": "Ojämnhet", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.3, "adv": true},
        {"key": "tint", "label": "Färgvariation", "type": "number", "min": 0, "max": 0.5, "step": 0.01, "default": 0.12, "adv": true},
        {"key": "seed", "label": "Frö", "type": "seed", "default": 1},
        {"key": "light", "label": "Pannans färg", "type": "color", "default": "#9C4A32"},
        {"key": "dark", "label": "Skuggans färg", "type": "color", "default": "#3A2420"}
      ]
    },
    "splat": {
      "label": "Mark och fläckar",
      "params": [
        {"key": "scale", "label": "Fläckarnas storlek", "type": "number", "min": 1, "max": 16, "step": 0.5, "default": 4, "help": "Antal fläckar över texturen"},
        {"key": "grass", "label": "Andel gräs", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.45},
        {"key": "gravel", "label": "Andel grus", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.25},
        {"key": "edge", "label": "Skarpa kanter", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.5, "adv": true},
        {"key": "detail", "label": "Fin detalj", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.35, "adv": true},
        {"key": "seed", "label": "Frö", "type": "seed", "default": 1},
        {"key": "soil", "label": "Jord", "type": "color", "default": "#6B4E32"},
        {"key": "grass_color", "label": "Gräs", "type": "color", "default": "#5E8A3A"},
        {"key": "gravel_color", "label": "Grus", "type": "color", "default": "#9A9384"}
      ]
    },
    "gradient": {
      "label": "Gradient och form",
      "help": "För masker och enkla målade ytor; ett helt antal band eller celler, så att den är sömlös",
      "params": [
        {"key": "kind", "label": "Sort", "type": "select", "options": {"Band": "linear", "Ringar": "radial", "Kuddar (per cell)": "cells"}, "default": "linear"},
        {"key": "bands", "label": "Antal", "type": "int", "min": 1, "max": 16, "default": 1},
        {"key": "vertical", "label": "Lodrätt", "type": "bool", "default": false, "when": {"kind": "linear"}},
        {"key": "softness", "label": "Mjukhet", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 1, "adv": true},
        {"key": "dark", "label": "Mörk färg", "type": "color", "default": "#333333"},
        {"key": "light", "label": "Ljus färg", "type": "color", "default": "#DDDDDD"}
      ]
    },
    "krea": {
      "label": "Krea (målad med AI)",
      "help": "Lokal ComfyUI med Krea-2. Första gången tar det cirka 3 minuter; resultatet cachas",
      "params": [
        {"key": "prompt", "label": "Beskrivning", "type": "text", "default": "mossy grey cobblestones", "help": "Beskriv bara materialet; stilen läggs till av Husets stil"},
        {"key": "base", "label": "Form från ingrediens", "type": "input", "default": "", "help": "Bild till bild: en ingrediens (t.ex. sten) bestämmer formen och Krea målar den"},
        {"key": "denoise", "label": "Hur mycket Krea får ändra", "type": "number", "min": 0.1, "max": 1, "step": 0.05, "default": 0.6, "when": {"base": {"not": ""}}},
        {"key": "seed", "label": "Frö", "type": "seed", "default": 1},
        {"key": "style", "label": "Husets stil", "type": "bool", "default": true, "adv": true},
        {"key": "seamless", "label": "Gör sömlös", "type": "bool", "default": true, "adv": true}
      ]
    },
    "image": {"label": "Befintlig textur", "params": [{"key": "name", "label": "Textur", "type": "texture", "default": "bark_painted"}]},
    "input": {"label": "Ingrediens", "params": [{"key": "input", "label": "Ingrediens", "type": "input", "default": ""}]}
  },
  "steps": {
    "layer": {
      "label": "Lager (ingrediens med mask)",
      "help": "Lägger en ingrediens ovanpå, styrd av en mask: mossa i fogarna, smuts i fårorna",
      "params": [
        {"key": "input", "label": "Ingrediens", "type": "input", "default": ""},
        {"key": "mask", "label": "Mask", "type": "select", "options": {"Ingen (överallt)": "none", "Fördjupningar (låg höjd)": "low", "Toppar (hög höjd)": "high", "Mörka partier": "dark", "Ljusa partier": "light", "Branta kanter": "slope", "Brus": "noise", "Annan ingrediens": "input"}, "default": "low"},
        {"key": "amount", "label": "Täckning", "type": "number", "min": 0, "max": 1, "step": 0.02, "default": 0.5},
        {"key": "opacity", "label": "Styrka", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 1, "adv": true},
        {"key": "softness", "label": "Mjuk kant", "type": "number", "min": 0.01, "max": 0.5, "step": 0.01, "default": 0.08, "adv": true},
        {"key": "mask_input", "label": "Maskens ingrediens", "type": "input", "default": "", "when": {"mask": "input"}},
        {"key": "breakup", "label": "Bruten kant", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.3, "adv": true},
        {"key": "breakup_scale", "label": "Brusets skala", "type": "number", "min": 1, "max": 32, "step": 1, "default": 10, "adv": true},
        {"key": "repeat", "label": "Ingrediensens upprepning", "type": "int", "min": 1, "max": 8, "default": 1, "adv": true},
        {"key": "mode", "label": "Blandning", "type": "select", "options": {"Täck": "mix", "Multiplicera": "multiply", "Overlay": "overlay", "Ljusare": "screen"}, "default": "mix", "adv": true},
        {"key": "height", "label": "Höjden", "type": "select", "options": {"Lagret lägger sig ovanpå": "fill", "Blanda": "mix", "Behåll basens": "keep"}, "default": "fill", "adv": true},
        {"key": "seed", "label": "Frö (brus)", "type": "seed", "default": 3, "adv": true}
      ]
    },
    "scatter": {
      "label": "Strö ut (stämplar)",
      "help": "Löv, småsten eller blommor utspridda över texturen, sömlöst",
      "params": [
        {"key": "shape", "label": "Stämpel", "type": "select", "options": {"Löv": "leaf", "Småsten": "pebble", "Blommor": "flower", "Prickar": "dot", "Pinnar": "twig", "Ingrediens": "input"}, "default": "leaf"},
        {"key": "input", "label": "Ingrediens", "type": "input", "default": "", "when": {"shape": "input"}},
        {"key": "count", "label": "Antal", "type": "int", "min": 1, "max": 600, "default": 60},
        {"key": "size", "label": "Storlek", "type": "number", "min": 0.01, "max": 0.3, "step": 0.005, "default": 0.06, "help": "Andel av texturens sida"},
        {"key": "size_var", "label": "Variation i storlek", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.4, "adv": true},
        {"key": "clump", "label": "Klumpighet", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.3, "adv": true, "help": "Samlar stämplarna i grupper"},
        {"key": "shade", "label": "Skuggning", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.5, "adv": true},
        {"key": "seed", "label": "Frö", "type": "seed", "default": 5},
        {"key": "dark", "label": "Mörk färg", "type": "color", "default": "#8A4E22", "when": {"shape": {"not": "input"}}},
        {"key": "light", "label": "Ljus färg", "type": "color", "default": "#D89A3A", "when": {"shape": {"not": "input"}}}
      ]
    },
    "tile": {
      "label": "Sömlös",
      "help": "Blandar kanterna med en förskjuten kopia, så att texturen går att upprepa utan söm",
      "params": [{"key": "width", "label": "Kantbredd", "type": "number", "min": 0.05, "max": 0.5, "step": 0.01, "default": 0.25}]
    },
    "levels": {
      "label": "Nivåer",
      "params": [
        {"key": "contrast", "label": "Kontrast", "type": "number", "min": 0.2, "max": 2, "step": 0.05, "default": 1},
        {"key": "lift", "label": "Ljushet", "type": "number", "min": -0.4, "max": 0.4, "step": 0.01, "default": 0},
        {"key": "gamma", "label": "Gamma", "type": "number", "min": 0.4, "max": 2.5, "step": 0.05, "default": 1, "adv": true}
      ]
    },
    "hsv": {
      "label": "Nyans och mättnad",
      "params": [
        {"key": "hue", "label": "Nyans (°)", "type": "number", "min": -180, "max": 180, "step": 1, "default": 0},
        {"key": "saturation", "label": "Mättnad", "type": "number", "min": 0, "max": 2, "step": 0.05, "default": 1},
        {"key": "value", "label": "Ljushet", "type": "number", "min": 0.3, "max": 1.7, "step": 0.05, "default": 1}
      ]
    },
    "colorramp": {
      "label": "Färgramp",
      "help": "Färgar om efter höjd eller ljushet: mörkt i fördjupningarna, ljust på topparna",
      "params": [
        {"key": "by", "label": "Efter", "type": "select", "options": {"Höjd": "height", "Ljushet": "lum"}, "default": "height"},
        {"key": "low", "label": "Lågt", "type": "color", "default": "#3B3A33"},
        {"key": "mid", "label": "Mitten", "type": "color", "default": "#7D7766"},
        {"key": "high", "label": "Högt", "type": "color", "default": "#C9C2AE"},
        {"key": "amount", "label": "Styrka", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 1},
        {"key": "mid_pos", "label": "Mittens läge", "type": "number", "min": 0.1, "max": 0.9, "step": 0.05, "default": 0.5, "adv": true},
        {"key": "keep_detail", "label": "Behåll detaljen", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.4, "adv": true}
      ]
    },
    "palette": {
      "label": "Mot paletten",
      "help": "Drar varje pixel mot närmaste färg i paletten (tools/style.json)",
      "params": [
        {"key": "amount", "label": "Styrka", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.4},
        {"key": "group", "label": "Färger", "type": "select", "options": {"Hela paletten": "all", "Löv": "foliage", "Barr": "conifer", "Bark och trä": "bark", "Sten": "stone", "Mark och sand": "ground"}, "default": "all"}
      ]
    },
    "edges": {
      "label": "Kanter och skrymslen",
      "help": "Ljusare kanter på det som sticker ut och mörkare i skrymslena, ur höjden (stilguidens kantljus)",
      "params": [
        {"key": "edge", "label": "Kantljus", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.35},
        {"key": "cavity", "label": "Mörka skrymslen", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.35},
        {"key": "radius", "label": "Bredd (px vid 1024)", "type": "number", "min": 1, "max": 24, "step": 0.5, "default": 4, "adv": true}
      ]
    },
    "height": {
      "label": "Höjd",
      "help": "Ändrar höjdkartan (som styr normal, AO, lager och blandning) utan att röra färgen",
      "params": [
        {"key": "from", "label": "Höjden ur", "type": "select", "options": {"Källan (behåll)": "keep", "Ljusheten": "lum", "Blandning": "mix"}, "default": "keep"},
        {"key": "mix", "label": "Andel ljushet", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.5, "when": {"from": "mix"}},
        {"key": "contrast", "label": "Kontrast", "type": "number", "min": 0.2, "max": 3, "step": 0.05, "default": 1},
        {"key": "invert", "label": "Vänd", "type": "bool", "default": false},
        {"key": "blur", "label": "Mjuka upp (px vid 1024)", "type": "number", "min": 0, "max": 16, "step": 0.5, "default": 0, "adv": true}
      ]
    },
    "warp": {
      "label": "Förvrängning",
      "help": "Böjer mönstret med mjukt brus, så att raka former blir mer organiska",
      "params": [
        {"key": "amount", "label": "Mängd", "type": "number", "min": 0, "max": 0.2, "step": 0.005, "default": 0.03},
        {"key": "scale", "label": "Skala", "type": "number", "min": 1, "max": 16, "step": 1, "default": 4},
        {"key": "seed", "label": "Frö", "type": "seed", "default": 7, "adv": true}
      ]
    },
    "gray": {
      "label": "Gråskala (för tint)",
      "help": "Färgen sätts sedan i materialet (leaf_tint, bark_tint)",
      "params": [{"key": "mean", "label": "Medelljushet", "type": "number", "min": 0.4, "max": 0.95, "step": 0.01, "default": 0.82}]
    },
    "soften": {"label": "Mjukare kontrast", "help": "Drar ner fåror och skåror men behåller stora former", "params": [{"key": "amount", "label": "Mängd", "type": "number", "min": 0, "max": 2, "step": 0.05, "default": 1}]},
    "frequency": {
      "label": "Frekvens (stora och små former)",
      "help": "Stilguiden vill låg frekvens: dra ner de små formerna och behåll de stora",
      "params": [
        {"key": "low", "label": "Stora former", "type": "number", "min": 0, "max": 2, "step": 0.05, "default": 1},
        {"key": "high", "label": "Små former", "type": "number", "min": 0, "max": 2, "step": 0.05, "default": 0.6},
        {"key": "radius", "label": "Gräns (px vid 1024)", "type": "number", "min": 1, "max": 32, "step": 0.5, "default": 6, "adv": true}
      ]
    },
    "paint": {
      "label": "Målad look",
      "help": "Kuwahara-filter: plana penseldrag som behåller kanter",
      "params": [{"key": "radius", "label": "Penselstorlek (px vid 1024)", "type": "number", "min": 1, "max": 16, "step": 0.5, "default": 4}]
    },
    "posterize": {
      "label": "Färre valörer",
      "params": [{"key": "levels", "label": "Valörer", "type": "int", "min": 2, "max": 16, "default": 6}, {"key": "softness", "label": "Mjukhet", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.3}]
    },
    "sharpen": {
      "label": "Skärpa",
      "params": [
        {"key": "amount", "label": "Mängd", "type": "number", "min": 0, "max": 2, "step": 0.05, "default": 0.5},
        {"key": "radius", "label": "Radie (px vid 1024)", "type": "number", "min": 0.5, "max": 8, "step": 0.5, "default": 1.5, "adv": true}
      ]
    },
    "range": {
      "label": "Valörgränser",
      "help": "Stilguiden: inget rent svart eller vitt (ungefär 8–90 %)",
