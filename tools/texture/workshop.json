      { "key": "round", "label": "Rundning", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.6 },
      { "key": "tint", "label": "Färgvariation", "type": "number", "min": 0, "max": 0.5, "step": 0.01, "default": 0.15 },
      { "key": "seed", "label": "Frö", "type": "seed", "default": 1 },
      { "key": "light", "label": "Stenens färg", "type": "color", "default": "#A9A39A" },
      { "key": "dark", "label": "Fogens färg", "type": "color", "default": "#4C4636" }
