{
  "_doc": "Gräset som recept (shared/effects/grass.js, docs/effektlabb.md): spakarna i Väderkvarnens gräskort, färdiga gräs och blomklungorna. Texten som visas är på engelska. Sparade gräs hamnar i assets/grass/<namn>.grass.json (gräset plus blomklungorna).",
  "groups": [
    {
      "id": "ground",
      "label": "Ground"
    },
    {
      "id": "color",
      "label": "Grass colour"
    },
    {
      "id": "shape",
      "label": "Grass shape"
    },
    {
      "id": "waves",
      "label": "Grass waves"
    }
  ],
  "params": [
    {
      "key": "ground",
      "group": "ground",
      "label": "Ground texture",
      "type": "texture",
      "kind": "ground",
      "default": "ground_meadow",
      "help": "The ground under the grass. It fills the gaps between the blades, especially when you look down into the grass"
    },
    {
      "key": "groundScale",
      "group": "ground",
      "label": "Ground tile (m)",
      "min": 0.5,
      "max": 12,
      "step": 0.1,
      "default": 3,
      "help": "Meters per repeat of the ground texture"
    },
    {
      "key": "groundBright",
      "group": "ground",
      "label": "Ground brightness",
      "min": 0.3,
      "max": 1.5,
      "step": 0.01,
      "default": 0.85,
      "help": "Darker ground reads as shade under the grass"
    },
    {
      "key": "rootFromGround",
      "group": "ground",
      "label": "Grass root color",
      "type": "bool",
      "default": true,
      "help": "Follow ground texture color: every blade takes its root colour from the ground where it stands, so the grass grows out of the ground"
    },
    {
      "key": "base",
      "group": "color",
      "label": "Root",
      "type": "color",
      "default": "#1c3a0e",
      "help": "The colour at the root, where the field is darkest"
    },
    {
      "key": "mid",
      "group": "color",
      "label": "Middle",
      "type": "color",
      "default": "#3a7a1a"
    },
    {
      "key": "tip",
      "group": "color",
      "label": "Tip",
      "type": "color",
      "default": "#8cc63a",
      "help": "The light colour at the tips"
    },
    {
      "key": "dry",
      "group": "color",
      "label": "Dry",
      "type": "color",
      "default": "#c8bd55",
      "help": "The colour of dry patches"
    },
    {
      "key": "dryAmount",
      "group": "color",
      "label": "Dry patches",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 0.25,
      "help": "How much of the field is dry"
    },
    {
      "key": "patches",
      "group": "color",
      "label": "Patch contrast",
      "min": 0,
      "max": 2,
      "step": 0.01,
      "default": 1,
      "help": "Large patches: warmer and yellower where the grass is high, darker and bluer where it is low"
    },
    {
      "key": "patchSize",
      "group": "color",
      "label": "Patch size (m)",
      "min": 1,
      "max": 30,
      "step": 0.5,
      "default": 6
    },
    {
      "key": "clumpShade",
      "group": "color",
      "label": "Clump variation",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 0.5,
      "help": "How different the clumps are in brightness"
    },
    {
      "key": "ao",
      "group": "color",
      "label": "Dark at the root",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 0.6
    },
    {
      "key": "translucency",
      "group": "color",
      "label": "Translucency",
      "min": 0,
      "max": 2,
      "step": 0.01,
      "default": 1,
      "help": "Light through the tips against the sun"
    },
    {
      "key": "heightMin",
      "group": "shape",
      "label": "Length, low (m)",
      "min": 0.03,
      "max": 1.5,
      "step": 0.01,
      "default": 0.17,
      "help": "Length where the field is low"
    },
    {
      "key": "heightMax",
      "group": "shape",
      "label": "Length, high (m)",
      "min": 0.05,
      "max": 2,
      "step": 0.01,
      "default": 0.38,
      "help": "Length where the field is high"
    },
    {
      "key": "width",
      "group": "shape",
      "label": "Blade width (m)",
      "min": 0.005,
      "max": 0.12,
      "step": 0.001,
      "default": 0.035
    },
    {
      "key": "taper",
      "group": "shape",
      "label": "Taper",
      "min": 0.5,
      "max": 6,
      "step": 0.05,
      "default": 1.8,
      "help": "Low = narrow all the way like a needle, high = wide until close to the tip"
    },
    {
      "key": "curve",
      "group": "shape",
      "label": "Bend",
      "min": 0,
      "max": 1.6,
      "step": 0.01,
      "default": 0.55,
      "help": "How much the blades curve by themselves"
    },
    {
      "key": "curveVar",
      "group": "shape",
      "label": "Bend variation",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 0.6
    },
    {
      "key": "clumpLean",
      "group": "shape",
      "label": "Clump spread",
      "min": 0,
      "max": 2,
      "step": 0.01,
      "default": 1,
      "help": "How much the blades lean out from the middle of their clump"
    },
    {
      "key": "clumpSize",
      "group": "shape",
      "label": "Clump size (m)",
      "min": 0.25,
      "max": 2.5,
      "step": 0.05,
      "default": 0.7,
      "rebuild": true,
      "help": "Distance between the clumps (rebuilds the blades)"
    },
    {
      "key": "stiffness",
      "group": "shape",
      "label": "Stiffness",
      "min": 0.3,
      "max": 3,
      "step": 0.01,
      "default": 1,
      "help": "Stiffer blades bend less in the wind and the waves"
    },
    {
      "key": "density",
      "group": "shape",
      "label": "Density",
      "min": 0.05,
      "max": 1,
      "step": 0.01,
      "default": 1,
      "help": "Share of the blades that are drawn"
    },
    {
      "key": "waveBend",
      "group": "waves",
      "label": "Wave bend",
      "min": 0,
      "max": 1.5,
      "step": 0.01,
      "default": 0.45,
      "help": "How far the blades bow when a wave passes"
    },
    {
      "key": "waveSheen",
      "group": "waves",
      "label": "Wave sheen",
      "min": 0,
      "max": 2,
      "step": 0.01,
      "default": 1,
      "help": "How much lighter the bowed blades get, like the rolling waves in Ghost of Tsushima"
    },
    {
      "key": "waveSize",
      "group": "waves",
      "label": "Wave size (m)",
      "min": 1.5,
      "max": 40,
      "step": 0.5,
      "default": 9,
      "help": "Distance between the waves"
    },
    {
      "key": "waveSpeed",
      "group": "waves",
      "label": "Wave speed (m/s)",
      "min": 0,
      "max": 20,
      "step": 0.1,
      "default": 4
    },
    {
      "key": "waveSharp",
      "group": "waves",
      "label": "Wave sharpness",
      "min": 1,
      "max": 10,
      "step": 0.1,
      "default": 3,
      "help": "Low = soft swells, high = narrow bright bands"
    },
    {
      "key": "waveBreakup",
      "group": "waves",
      "label": "Wave breakup",
      "min": 0,
      "max": 1.5,
      "step": 0.01,
      "default": 0.6,
      "help": "Straight fronts or wavy, broken ones"
    }
  ],
