{
  "id": "yvonne-low-from-high",
  "title": "Yvonne low: remesh of the 4-view high model + Meshy 4K texture",
  "project": "asset-studio",
  "asset": "yvonne-low2",
  "use": "test-only",
  "inputs": {
    "high.glb": "../../../../build/characters/yvonne_meshy/yvonne_meshy_high_v1.glb",
    "front.png": "../../../../../../lowpoly-test/input/yvonne/front.png",
    "left.png": "../../../../../../lowpoly-test/input/yvonne/left.png",
    "back.png": "../../../../../../lowpoly-test/input/yvonne/back.png",
    "right.png": "../../../../../../lowpoly-test/input/yvonne/right.png"
  },
  "steps": [
    {"key": "remesh", "label": "Remesh high to 8k tris (Meshy)", "kind": "remesh", "mesh": "$in:high.glb",
     "params": {"topology": "triangle", "target_polycount": 8000}},
    {"key": "texture", "label": "Texture (Meshy 4K, 4 views)", "kind": "texture", "force": "cloud",
     "cloud": {"mesh": "$step:remesh", "views": ["$in:front.png", "$in:left.png", "$in:back.png", "$in:right.png"],
               "resolution": "4k", "keep_uv": false}},
    {"key": "review", "label": "Review: low model", "kind": "review", "images": ["$step:texture"], "refs": ["$in:front.png", "$in:left.png"],
     "criteria": ["The model is the same woman as the reference: build, proportions, hair bun, dark teal two-piece outfit, skin tone.",
                  "She stands upright like the side reference, not bent forward at the hips or with the head pushed forward.",
                  "No missing limbs, merged fingers or broken surfaces visible in the views."], "stop_on_fail": false}
  ]
}
